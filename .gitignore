# Stockfish engines -- fetched by `python3 tools/fetch_assets.py`, never committed.
# These are bundled by pubspec.yaml and must exist before `flutter build`.
# assets/maia3_simplified.onnx is deliberately NOT here: it has no upstream to
# fetch from, so git is the only copy.
assets/executables/*.gz

# Regenerable scrape caches (see scripts/chesscom_titled_analysis/fetch_data.py).
# Note: scripts/data/ is deliberately NOT ignored -- it is only ~3 MB and holds
# the player map that build_player_map.py incrementally builds and resumes.
scripts/chesscom_titled_analysis/data/

# Sample TWIC input -- re-fetch with python/twic-position-finder/downloader.py
twic*.pgn

# harness results: trees, sandboxes, logs (keep compare reports)
tools/experiments/fast_vs_pure/results/*/fast/
tools/experiments/fast_vs_pure/results/*/pure/
tools/experiments/fast_vs_pure/results/*/*.log
tools/experiments/fast_vs_pure/results/*/pid

# benko_master harness: keep the scripts, not the runs (trees, engine copies, pids)
tools/experiments/benko_master/run_*/
tools/experiments/benko_master/ab_*/
tools/experiments/benko_master/LATEST*

# Claude Code. The agent contract — the Flutter-lock gate hook, the app-driver
# skill, the slash commands — is TRACKED on purpose: it is what makes a fresh
# clone behave, and scripts/doctor.sh fails if any of it goes untracked.
# Only per-machine and per-session state is ignored.
.claude/settings.local.json
.claude/RESUME.md

# Bughouse engine bundle: the Hivemind CPU build (engine + ONNX Runtime +
# FP32 network, ~43 MB gzipped). Downloaded by tools/fetch_bughouse.py, the
# same way Stockfish is fetched rather than tracked.
#
# .gitkeep is tracked on purpose, exactly as it is under assets/executables.
# pubspec.yaml declares this whole directory as an asset, and a *missing*
# asset directory is not a build failure -- `flutter build` prints
# "unable to find directory entry in pubspec.yaml" and exits 0. Without a
# tracked file here, a release would build green and ship with no engine.
assets/bughouse/*.gz
assets/bughouse/manifest.json

# Official Microsoft VC++ prerequisite. Release CI fetches and verifies the
# pinned package; the 25 MB executable is embedded in the Windows installer,
# never committed to the repository.
packaging/windows/prerequisites/VC_redist.x64.exe
!tools/vc_redist.lock.json

# Agent worktrees created inside the checkout by Claude Code's worktree mode.
# Each is a full second checkout (hundreds of MB) with its own branch; they are
# per-session scratch, never repository content.
.claude/worktrees/
