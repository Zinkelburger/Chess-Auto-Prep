/stockfish/*
  Cache-Control: public, max-age=31536000, immutable

/piece/*
  Cache-Control: public, max-age=31536000, immutable

/board/*
  Cache-Control: public, max-age=31536000, immutable

/bughouse-puzzles/s*.json
  Cache-Control: public, max-age=31536000, immutable

/bughouse-puzzles/index.json
  Cache-Control: public, max-age=600

# The bughouse board runs Hivemind's network on several CPU threads when the
# browser has no WebGPU, which needs SharedArrayBuffer, so only this page and
# its engine files are cross-origin isolated.
/bughouse
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/bughouse/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/bughouse-engine/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

# An isolated page may start a worker only from a script that is isolated too;
# the engine worker is bundled here. The headers change nothing for other pages.
/_astro/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

