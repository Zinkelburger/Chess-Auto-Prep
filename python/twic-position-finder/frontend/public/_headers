/stockfish/*
  Cache-Control: public, max-age=31536000, immutable

/piece/*
  Cache-Control: public, max-age=31536000, immutable

/board/*
  Cache-Control: public, max-age=31536000, immutable

/bughouse-puzzles/s*.json
  Cache-Control: public, max-age=31536000, immutable

/bughouse-puzzles/index.json
  Cache-Control: public, max-age=600

# The bughouse board runs Lichess's multi-threaded Fairy-Stockfish, which needs
# SharedArrayBuffer, so only this page and its engine files are cross-origin isolated.
/bughouse
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/bughouse/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/crazyhouse-engine/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

