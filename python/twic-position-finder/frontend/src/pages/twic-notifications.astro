---
import Base from '../layouts/Base.astro';
import AlertOptions from '../components/AlertOptions.astro';
---
<Base title="TWIC Notifications">
  <header class="page-header">
    <div>
      <h1>TWIC Notifications</h1>
      <p class="lede">
        Get an email every Tuesday when
        <a href="https://theweekinchess.com/" target="_blank" rel="noopener">The Week in Chess</a>
        publishes games that match your filters.
      </p>
    </div>
  </header>

  <section class="card">
    <h2>Create an alert</h2>
    <div id="subscribe-alert" hidden></div>
    <form id="subscribe-form">
      <div class="form-row">
        <label for="sub-email">Email</label>
        <input type="email" id="sub-email" name="email" required autocomplete="email" />
      </div>
      <div class="form-row">
        <label for="sub-label">Label <span class="optional">optional</span></label>
        <input type="text" id="sub-label" placeholder="e.g. Najdorf, Carlsen with Black" />
      </div>

      <div class="filters-section">
        <div class="filters-header">
          <span class="filters-title">Filters</span>
          <span class="filters-hint">At least one of FEN, player, or ECO</span>
        </div>
        <div id="filters-container"></div>
        <div class="add-filter-wrap">
          <button type="button" class="btn btn-outline btn-sm" id="add-filter-btn">Add filter</button>
          <div id="filter-menu" class="filter-menu" hidden></div>
        </div>
      </div>

      <AlertOptions idPrefix="sub" excludeId="sub-exclude-online" />

      {import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && (
        <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY} data-appearance="interaction-only"></div>
      )}

      <button type="submit" class="btn btn-primary" id="submit-btn">Subscribe</button>
    </form>
  </section>

  <section class="card">
    <h2>Already subscribed?</h2>
    <p class="card-lead">We’ll email you a link to manage your alerts.</p>
    <form id="login-form" class="inline-form">
      <div class="form-row grow">
        <label for="login-email">Email</label>
        <input type="email" id="login-email" required autocomplete="email" />
      </div>
      <button type="submit" class="btn btn-outline">Send login link</button>
    </form>
    <div id="login-alert" hidden></div>
  </section>
</Base>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { initSubscribePage } from '../lib/subscribe-page';
  initSubscribePage();
</script>
