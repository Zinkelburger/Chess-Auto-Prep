---
import Base from '../layouts/Base.astro';
import BughouseBoards from '../components/BughouseBoards.astro';
import '../styles/bughouse-board.css';
import '../styles/bughousedb.css';
const TURNSTILE = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<Base title="BughouseDB" description="Every legal bughouse move scored by Hivemind for three clock situations. Click through positions; analyse missing ones in your browser." fill>
  <div id="bughousedb" class="bb-app" data-turnstile={TURNSTILE ?? ''}>
    <h1 class="visually-hidden">BughouseDB</h1>
    <noscript><p class="alert alert-error">Enable JavaScript to browse the book.</p></noscript>

    <form id="bdb-fen-form" class="bb-left" novalidate>
      <BughouseBoards prefix="bdb" />
    </form>

    <div class="bb-right">
      <p id="bdb-source" class="bdb-source dim"></p>
      <div class="bdb-tables">
        <section id="bdb-missing" class="bdb-missing" hidden>
          <div class="bdb-missing-row">
            <button id="bdb-analyse" class="btn btn-primary" title="Run Hivemind in this browser and add the position to the book for everyone">Analyze locally</button>
            <button id="bdb-cancel" class="btn btn-outline" hidden>Cancel</button>
            <label class="bdb-cores" title="Searches run side by side, one per core. More cores finish sooner.">Cores <input id="bdb-cores" type="number" min="1" step="1" inputmode="numeric" /></label>
            <span id="bdb-missing-text" class="dim">Not in the book yet.</span>
          </div>
          {TURNSTILE && <div class="cf-turnstile" data-sitekey={TURNSTILE} data-appearance="interaction-only"></div>}
          <div id="bdb-progress" class="bdb-progress" hidden><i></i></div>
          <p id="bdb-status" class="bdb-status dim" role="status"></p>
        </section>
        <div class="bdb-priority">
          <span class="bdb-priority-label">Clock<span class="bb-info" tabindex="0" role="img" aria-label="About the clock" title="Both partners share one margin: if A is up on their diagonal, B is up by exactly the same amount against theirs. The team that is up can wait rather than move.">i</span></span>
          <div class="choice-row" role="radiogroup" aria-label="Clock">
            {[['ahead', 'A + B may sit', 'A + B are up on the diagonal clock, so they can wait rather than move'],
              ['even', 'Even', 'Neither team is up on the clock: both have to move'],
              ['behind', 'C + D may sit', 'C + D are up on the diagonal clock, so they can wait rather than move'],
            ].map(([value, text, hint]) => (
              <label class="choice" title={hint}>
                <input type="radio" name="bdb-priority" value={value} checked={value === 'even'} />
                <span>{text}</span>
              </label>
            ))}
          </div>
        </div>
        {['A', 'B'].map((name, i) => (
          <section class="bdb-table-panel" aria-label={`Board ${i + 1} moves`}>
            <h2 class="bdb-table-title">Board {i + 1}</h2>
            <div class="bdb-table-wrap">
            <table class="bdb-table" aria-label={`Moves on board ${i + 1}`}>
              <thead><tr>
                <th scope="col" id={`bdb-mover-${name}`}>Move</th>
                <th scope="col" id={`bdb-score-${name}`}>Score</th>
              </tr></thead>
              <tbody id={`bdb-moves-${name}`}></tbody>
            </table>
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
  {TURNSTILE && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>

<script>
  import '../bughousedb/app';
</script>
