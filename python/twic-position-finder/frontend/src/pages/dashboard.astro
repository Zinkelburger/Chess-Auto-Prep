---
// The dashboard merged into /twic-notifications (one page decides between the
// front door and the signed-in list). This shim keeps old bookmarks and any
// still-unopened login emails working: it forwards to the alerts page with
// the query string intact, so `?token=` login links keep exchanging.
import Base from '../layouts/Base.astro';
---
<Base title="TWIC Alerts">
  <div class="status-panel">
    <p class="lede">Taking you to your alerts…</p>
    <a class="btn btn-primary" id="go" href="/twic-notifications">Open TWIC Alerts</a>
  </div>
</Base>

<script is:inline>
  (function () {
    var target = '/twic-notifications' + window.location.search;
    document.getElementById('go').setAttribute('href', target);
    window.location.replace(target);
  })();
</script>
