---
import Base from '../layouts/Base.astro';
import '../styles/alerts.css';
---
<Base
  title="Tactics Trainer"
  description="Puzzles mined from your own Lichess and Chess.com games. Stockfish runs in your browser and finds the moves you missed."
  wide
>
  <!-- ── Setup ─────────────────────────────────────────────────── -->
  <div id="view-setup">
    <header class="page-header">
      <div>
        <h1>Tactics Trainer</h1>
        <p class="lede">
          Puzzles from your own games. Stockfish runs in your browser, replays each game, and turns every
          mistake into a position to solve — nothing is uploaded anywhere.
        </p>
      </div>
    </header>

    <div class="setup-wrap">
      <form id="setup-form" class="card setup-card" novalidate>
        <div id="setup-alert" class="alert alert-error" hidden></div>

        <div class="form-grid">
          <div class="form-row">
            <label for="f-lichess">Lichess username</label>
            <input type="text" id="f-lichess" autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="e.g. DrNykterstein" />
          </div>
          <div class="form-row">
            <label for="f-chesscom">Chess.com username</label>
            <input type="text" id="f-chesscom" autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="e.g. Hikaru" />
          </div>
        </div>

        <div class="form-row">
          <span class="field-label">Time controls</span>
          <div id="f-timeclasses" class="choice-row" role="group" aria-label="Time controls"></div>
        </div>

        <div class="form-grid setup-numbers">
          <div class="form-row">
            <label for="f-games">Number of games</label>
            <input type="number" id="f-games" min="1" max="200" inputmode="numeric" />
          </div>
          <div class="form-row">
            <label for="f-severity">Include</label>
            <select id="f-severity">
              <option value="mistake">Mistakes and blunders</option>
              <option value="inaccuracy">Inaccuracies too</option>
            </select>
          </div>
        </div>

        <details class="advanced">
          <summary>Engine settings</summary>
          <div class="form-grid">
            <div class="form-row">
              <label for="f-depth">Search depth <span class="tooltip-trigger" title="Deeper is more accurate and slower. 14 is fine for blitz; 18 if you want to trust the lines." aria-label="Depth help">?</span></label>
              <input type="number" id="f-depth" min="8" max="22" inputmode="numeric" />
            </div>
            <div class="form-row">
              <label for="f-workers">Engine workers <span class="dim">(up to <span id="f-workers-max"></span>)</span></label>
              <input type="number" id="f-workers" min="1" inputmode="numeric" />
            </div>
          </div>
          <p class="hint">Each worker is an independent Stockfish; positions are shared across them. Results are cached on this device, so re-running the same account only analyses new games.</p>
          <button type="button" class="btn btn-text" id="btn-clear-cache">Clear cached analysis</button>
        </details>

        <div class="setup-actions">
          <button type="submit" class="btn btn-primary btn-lg" id="btn-start">Find my mistakes</button>
          <span id="engine-status" class="engine-status">Engine loading…</span>
        </div>
      </form>

    </div>
  </div>

  <!-- ── Analysing ─────────────────────────────────────────────── -->
  <div id="view-analysis" hidden>
    <div class="card analysis-card">
      <div class="analysis-head">
        <div>
          <h2 id="an-title">Fetching games…</h2>
          <p class="dim" id="an-sub"></p>
        </div>
        <span class="num dim" id="an-elapsed">0s</span>
      </div>
      <div id="an-progress" class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div id="an-bar" class="progress-bar"></div>
      </div>
      <dl class="stats">
        <div><dt>Games</dt><dd class="num" id="an-games">0 / 0</dd></div>
        <div><dt>Puzzles found</dt><dd class="num" id="an-found">0</dd></div>
        <div title="Positions settled from the cache, from the game's own server analysis, or because you played the engine's move — no search needed."><dt>Already known</dt><dd class="num" id="an-shortcuts">0</dd></div>
        <div><dt>Engine</dt><dd class="num" id="an-engine">—</dd></div>
      </dl>
      <p class="dim analysis-current" id="an-current"></p>
      <div class="alert alert-warn" id="an-note" hidden></div>
      <div class="btn-row">
        <button type="button" class="btn btn-primary" id="btn-train-now" disabled>Start training now</button>
        <button type="button" class="btn btn-outline" id="btn-cancel">Cancel</button>
      </div>
    </div>
  </div>

  <!-- ── Training ──────────────────────────────────────────────── -->
  <div id="view-train" hidden>
    <div class="train-bar">
      <button type="button" class="btn btn-outline btn-sm" id="btn-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Setup
      </button>
      <div class="train-bar-mid">
        <span class="num train-counter" id="tr-counter">0 / 0</span>
        <span class="dim num" id="tr-session-score"></span>
      </div>
      <label class="checkbox-label" title="Auto-advance to the next puzzle after a solve (J)">
        <input type="checkbox" id="chk-autonext" />
        <span>Auto-advance</span>
      </label>
    </div>

    <div class="alert alert-info analysing-banner" id="tr-analysing" hidden>
      <span class="spinner" aria-hidden="true"></span>
      <span id="tr-analysing-text"></span>
    </div>

    <div class="train-layout">
      <div class="board-col">
        <div id="board" class="trainer-board"></div>
      </div>

      <div class="side-col">
        <div class="turn-box turn-turn" id="tr-turn" aria-live="polite">
          <img class="turn-icon" id="tr-turn-icon" src="/piece/wK.svg" alt="" width="44" height="44" />
          <div class="turn-text">
            <div class="turn-title" id="tr-turn-title">Your move</div>
            <div class="turn-sub" id="tr-turn-sub">Find the best move.</div>
          </div>
        </div>

        <div class="card side-card">
          <div class="played-row">
            <span id="tr-played" class="played"></span>
            <span id="tr-severity" class="badge"></span>
          </div>

          <div class="line" id="tr-line" hidden>
            <span class="eyebrow">Best line</span>
            <div class="line-moves" id="tr-line-moves"></div>
            <div class="line-nav" id="tr-line-nav" hidden>
              <button type="button" class="btn btn-outline btn-sm btn-icon" id="btn-line-prev" aria-label="Previous move in line" title="Previous move in the line (←)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
              </button>
              <button type="button" class="btn btn-outline btn-sm btn-icon" id="btn-line-next" aria-label="Next move in line" title="Next move in the line (→)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
              </button>
            </div>
          </div>

          <div class="controls">
            <button type="button" class="btn btn-outline" id="btn-prev" title="Previous puzzle (P or ↑)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
              Previous
            </button>
            <button type="button" class="btn btn-outline" id="btn-solution" title="Show the solution (space)">View solution</button>
            <button type="button" class="btn btn-outline" id="btn-retry" title="Reset the position">Retry</button>
            <button type="button" class="btn btn-primary" id="btn-next" title="Next puzzle (S or ↓)">
              Next
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        </div>

        <div class="card side-card game-card">
          <div class="game-head">
            <span class="eyebrow">From your game</span>
            <div class="game-links">
              <a id="tr-game-link" class="link-ext" target="_blank" rel="noopener" href="#">Open game ↗</a>
              <a id="tr-analyse-link" class="link-ext" target="_blank" rel="noopener" href="#">Analyse position ↗</a>
            </div>
          </div>
          <div class="game-players"><span id="tr-players"></span> <span class="game-result num" id="tr-result"></span></div>
          <div class="game-sub" id="tr-game-sub"></div>
        </div>

        <div class="session">
          <span class="eyebrow">Session</span>
          <div class="session-strip" id="tr-session" role="list"></div>
        </div>
      </div>
    </div>
  </div>
</Base>

<!-- Global on purpose: the move tokens and session cells are created by
     app.ts at runtime, so Astro's scoped selectors would never match them. -->
<style is:global>
  /* ── Setup ─────────────────────────────────────────────────── */
  .setup-wrap { max-width: 720px; }
  .setup-card { margin-bottom: 0; }
  .setup-numbers { max-width: 520px; }
  .advanced { border-top: 1px solid var(--border); padding-top: 14px; margin: 4px 0 18px; }
  .advanced summary { cursor: pointer; font-size: 0.9rem; font-weight: 600; color: var(--text-dim); margin-bottom: 14px; list-style: none; display: flex; align-items: center; gap: 8px; }
  .advanced summary::-webkit-details-marker { display: none; }
  .advanced summary::before { content: '▸'; font-size: 0.7rem; transition: transform 0.15s; }
  .advanced[open] summary::before { transform: rotate(90deg); }
  .advanced summary:hover { color: var(--text); }
  .advanced .hint { margin-bottom: 8px; }
  .setup-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .engine-status { font-size: 0.82rem; color: var(--text-dim); }

  /* ── Analysing ─────────────────────────────────────────────── */
  .analysis-card { max-width: 640px; margin: 24px auto; }
  .analysis-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 16px; }
  .analysis-head h2 { margin-bottom: 4px; }
  .progress { height: 8px; background: var(--bg-input); border-radius: 999px; overflow: hidden; margin-bottom: 18px; }
  .progress-bar { height: 100%; width: 0; background: var(--accent); border-radius: 999px; transition: width 0.25s ease-out; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 14px; }
  @media (max-width: 560px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  .stats dt { font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-dim); font-weight: 600; }
  .stats dd { font-size: 1.15rem; font-weight: 600; }
  .analysis-current { font-size: 0.85rem; min-height: 1.4em; margin-bottom: 14px; }

  /* ── Training ──────────────────────────────────────────────── */
  .train-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
  .train-bar-mid { display: flex; align-items: baseline; gap: 12px; }
  .train-counter { font-family: var(--mono); font-weight: 600; font-size: 1rem; }
  .analysing-banner { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .train-layout { display: grid; grid-template-columns: minmax(280px, 560px) minmax(300px, 1fr); gap: 24px; align-items: start; }
  @media (max-width: 800px) { .train-layout { grid-template-columns: 1fr; } }
  .board-col { width: 100%; }
  .trainer-board { width: 100%; aspect-ratio: 1; border-radius: 4px; overflow: hidden; box-shadow: var(--shadow); }
  .side-col { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .side-card { margin-bottom: 0; padding: 18px 20px; }

  /* lila's "your turn" box */
  .turn-box {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 18px; border-radius: var(--radius);
    background: var(--bg-card); border: 1px solid var(--border);
    transition: background 0.2s, border-color 0.2s;
  }
  .turn-icon { width: 44px; height: 44px; flex: none; }
  .turn-title { font-size: 1.15rem; font-weight: 700; line-height: 1.2; }
  .turn-sub { font-size: 0.9rem; color: var(--text-dim); margin-top: 2px; }
  .turn-good, .turn-win { background: var(--ok-bg); border-color: var(--ok); }
  .turn-good .turn-title, .turn-win .turn-title { color: var(--ok); }
  .turn-bad, .turn-fail { background: var(--danger-bg); border-color: var(--danger); }
  .turn-bad .turn-title, .turn-fail .turn-title { color: var(--danger); }

  .played-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
  .played { display: inline-flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .win-shift { font-size: 0.85rem; color: var(--text-dim); }

  .san-token {
    font-family: var(--mono); font-size: 0.98rem; font-weight: 600;
    background: none; border: none; color: var(--text);
    border-radius: 4px; padding: 3px 6px; line-height: 1.3; cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .san-token.played { cursor: default; padding-left: 0; }
  button.san-token:hover, button.san-token:focus-visible { background: var(--bg-raised); color: var(--text); outline: none; }
  .san-token.best { color: var(--ok); }
  .san-token.active { background: var(--pick-bg); color: var(--text); }

  .line { margin-bottom: 16px; }
  .line-moves { display: flex; flex-wrap: wrap; gap: 2px; margin: 6px 0 8px; }
  .line-nav { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

  .controls { display: grid; grid-template-columns: auto 1fr auto auto; gap: 8px; }
  .controls .btn { justify-content: center; }
  @media (max-width: 480px) { .controls { grid-template-columns: 1fr 1fr; } }

  .game-card { padding: 14px 20px; }
  .game-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
  .game-links { display: flex; gap: 14px; }
  .game-players { font-size: 0.95rem; }
  .game-result { font-weight: 600; margin-left: 6px; color: var(--text-dim); }
  .game-sub { font-size: 0.8rem; color: var(--text-dim); margin-top: 2px; }

  .session { padding: 0 2px; }
  .session-strip { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
  .session-cell {
    width: 14px; height: 14px; border-radius: 3px; padding: 0; border: 1px solid var(--border);
    background: var(--bg-input); cursor: pointer; transition: transform 0.1s;
  }
  .session-cell:hover { transform: scale(1.25); }
  .session-cell.win { background: var(--ok); border-color: var(--ok); }
  .session-cell.fail { background: var(--danger); border-color: var(--danger); }
  .session-cell.current { outline: 2px solid var(--text); outline-offset: 1px; }
</style>

<style is:global>
  /* Chessground theme: base + brown board + cburnett pieces, tinted to the site. */
  @import 'chessground/assets/chessground.base.css';
  @import 'chessground/assets/chessground.brown.css';
  @import 'chessground/assets/chessground.cburnett.css';
  .trainer-board cg-container, .trainer-board .cg-wrap { width: 100%; height: 100%; }
  /* Lichess's actual default board: lila ships 'brown' as a textured webp
     (public/images/board/brown.webp) with per-square coordinate colours,
     not chessground's flat two-colour fallback. */
  .trainer-board cg-board { background-image: url('/board/brown.webp'); }
  .trainer-board coords { text-shadow: none; }
  .trainer-board coords .coord-light { color: #946f51; }
  .trainer-board coords .coord-dark { color: #f0d9b5; }
</style>

<script>
  import { TacticsApp } from '../tactics/app';
  new TacticsApp();
</script>
