---
// Charles Clock — Charles Woodruff's "endgame blitz" chess clock.
//
// Both players start with a short time control. When you capture a piece you
// may hit the clock with a capture button instead of the plain zone, which
// permanently adds seconds to a cumulative increment that BOTH players then
// receive on every move. Heavier piece → bigger increment. Ported from the
// Excel/VBA prototype ("EndGain Clock Update.xlsm").
//
// The workbook is the authority on the rules, and it settles two questions the
// UI has to answer: the increment is a single shared counter (VBA mCumAddback,
// one cell labelled "Total cumulative increment:", paid to whichever clock is
// running at each hit — so both players receive every raise), and the ladder is
// 2/4/6 for knight-or-bishop/rook/queen, per the sheet's own button captions.
// Charles's original written prompt asked for 3/6/9; the workbook supersedes it.
//
// Phone ergonomics follow lichess mobile's clock tool: the whole half is the
// tap target, hits fire on pointerdown, controls that could ruin a game are
// disabled while the clock ticks, and the screen is kept awake. The running
// half turns light — a polarity flip reads through glare on a dim phone in a
// bright room, where a dark green tint on a dark grey does not. Two places we
// go further, because our capture hit is the one irreversible action: every
// hit is undoable, and the capture buttons sit at the far edge of each half
// (a natural slap lands on the big digits) and are `disabled` unless it is
// that side's turn, so a stray tap falls through to a plain hit.

import ClockSide from '../components/ClockSide.astro';

const ICON = {
  play: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>',
  pause: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.4v14H7zM13.6 5H17v14h-3.4z"/></svg>',
  undo: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-4"/></svg>',
  reset: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><path d="M20 3v5h-5"/></svg>',
  rules: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.2a2.6 2.6 0 0 1 5 1c0 1.8-2.5 2.3-2.5 3.8"/><path d="M12 17.2h.01"/></svg>',
  flip: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4 4 7l3 3"/><path d="M4 7h16"/><path d="m17 14 3 3-3 3"/><path d="M20 17H4"/></svg>',
  full: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5"/><path d="M20 9V4h-5"/><path d="M4 15v5h5"/><path d="M20 15v5h-5"/></svg>',
};

---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Charles Clock" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="theme-color" content="#111317" />
  <meta name="description" content="Charles Clock — blitz that ends in real endgames. Capturing a piece permanently raises the increment for both players." />
  <link rel="manifest" href="/charles-clock.webmanifest" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⏱</text></svg>" />
  <link rel="apple-touch-icon" href="/charles-clock-192.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Code+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <title>Charles Clock — Chess Auto Prep</title>
</head>
<body>
  <div id="app" class="app">

    <ClockSide side="top" name="Black" />

    <div class="bar">
      <button class="ctl ctl-primary" data-action="startpause" type="button" aria-label="Start">
        <span class="ctl-icon icon-play" set:html={ICON.play} />
        <span class="ctl-icon icon-pause" set:html={ICON.pause} />
        <span class="ctl-text" data-primary-label>Start</span>
      </button>
      <!-- While a game runs, the buttons beside Start/Pause are disabled and
           Undo sits at the far end, so a hurried tap at the middle cannot
           land on anything that changes the game. -->
      <button class="ctl" data-action="settings" type="button" aria-label="Rules and time control">
        <span class="ctl-icon" set:html={ICON.rules} /><span class="ctl-text">Rules</span>
      </button>
      <button class="ctl" data-action="flip" type="button" aria-label="Swap the two players' ends">
        <span class="ctl-icon" set:html={ICON.flip} /><span class="ctl-text">Flip</span>
      </button>
      <button class="ctl" data-action="reset" type="button" aria-label="Reset the clock">
        <span class="ctl-icon" set:html={ICON.reset} /><span class="ctl-text" data-reset-label>Reset</span>
      </button>
      <button class="ctl" data-action="fullscreen" type="button" hidden aria-label="Toggle full screen">
        <span class="ctl-icon" set:html={ICON.full} /><span class="ctl-text">Full</span>
      </button>
      <button class="ctl" data-action="undo" type="button" disabled aria-label="Undo last clock hit">
        <span class="ctl-icon" set:html={ICON.undo} /><span class="ctl-text">Undo</span>
      </button>
    </div>

    <ClockSide side="bottom" name="White" />

    <!-- Settings sheet -->
    <div class="sheet-backdrop" data-sheet hidden>
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="settings-title">
        <h2 id="settings-title">Charles Clock</h2>
        <p class="help">Blitz that ends in a real endgame instead of a scramble.</p>
        <ul class="rules">
          <li><strong>Hit your own side</strong> to end your move. Black taps first to
            start White's clock.</li>
          <li><strong>Captured a piece?</strong> Hit that piece's button instead. It ends
            your move <em>and</em> raises the increment. Bigger piece, bigger raise.</li>
          <li><strong>The increment is shared.</strong> Both players get it, on every move,
            for the rest of the game.</li>
          <li><strong>Raises stack and never come back down.</strong> Trade queens and
            that is <span class="num">+<span data-queen-trade>12</span>s</span> a move from
            then on — one raise each.</li>
          <li><strong>The capture buttons are optional.</strong> You can always just hit
            your own side instead.</li>
        </ul>

        <form data-settings-form>
          <h3>Time control</h3>
          <fieldset class="presets">
            <legend>Start time</legend>
            <div class="chips">
              {[1, 2, 3, 5, 10].map((m) => (
                <button type="button" class="preset" data-preset-min={m}>{m} min</button>
              ))}
            </div>
          </fieldset>

          <div class="grid2">
            <label>Start time (minutes)
              <input type="number" name="minutes" min="0.25" max="180" step="0.25" inputmode="decimal" required />
            </label>
            <label>Base increment (s)
              <input type="number" name="base" min="0" max="60" step="1" inputmode="numeric" required />
            </label>
          </div>

          <fieldset class="presets">
            <legend>Capture ladder</legend>
            <div class="chips">
              <button type="button" class="preset" data-preset-ladder="1,2,3">Gentle 1/2/3</button>
              <button type="button" class="preset" data-preset-ladder="2,4,6">Classic 2/4/6</button>
              <button type="button" class="preset" data-preset-ladder="3,6,10">Steep 3/6/10</button>
            </div>
          </fieldset>

          <div class="grid3">
            <label>♘♗ adds
              <input type="number" name="minor" min="0" max="60" step="1" inputmode="numeric" required />
            </label>
            <label>♖ adds
              <input type="number" name="rook" min="0" max="60" step="1" inputmode="numeric" required />
            </label>
            <label>♕ adds
              <input type="number" name="queen" min="0" max="60" step="1" inputmode="numeric" required />
            </label>
          </div>

          <label class="check">
            <input type="checkbox" name="sound" /> Sound on hit, low time &amp; flag
          </label>
          <label class="check">
            <input type="checkbox" name="facing" /> Face the players (rotate the far side 180°)
          </label>

          <div class="sheet-actions">
            <button type="button" class="ctl ctl-wide ctl-dim" data-action="settings-cancel">Cancel</button>
            <button type="submit" class="ctl ctl-wide ctl-primary">Save &amp; reset</button>
          </div>
        </form>

        <p class="credit">
          Concept by Charles Woodruff.<span class="keys"> Keys: <kbd>space</kbd> pause · <kbd>↑</kbd><kbd>↓</kbd> hit · <kbd>u</kbd> undo · <kbd>r</kbd> reset · <kbd>f</kbd> swap ends.</span>
          <a href="/">Chess Auto Prep</a>
        </p>
      </div>
    </div>
  </div>

  <script>
    import { initCharlesClock } from '../lib/charles-clock';
    initCharlesClock();
  </script>
</body>
</html>

<style is:global>
  /* Read in glare and in the dark. Live text clears 6.5:1 on the surface it
     sits on (the digits 13:1 or more), and whose clock runs is a light/dark polarity flip,
     not a tint: the running half is pale, everything else is near black. */
  :root {
    --bg: #111317;
    --bg-card: #1a1d22;     /* a waiting half */
    --bg-input: #262b33;
    --border: #3d4550;
    --text: #f3f5f8;
    --text-dim: #bcc4cf;    /* 10.3:1 on a waiting half */
    --accent: #5f93cc;
    --accent-hover: #7fb0ea;
    --accent-ink: #0d1117;
    --inc: #8dbcf0;         /* the shared increment, on dark — 8.6:1 */
    /* The running half: pale green, near-black ink. */
    --live-bg: #d6eedc;
    --live-ink: #06120a;
    --live-dim: #284a33;    /* 8.0:1 */
    --live-inc: #154f8c;    /* 6.6:1 */
    --live-line: #2f5a3d;
    /* Low time on the running half: pale red, blinking deeper. */
    --low-bg: #ffd8cf;
    --low-bg-blink: #ffb6a5;
    --low-ink: #2b0702;
    --danger: #ff9e9e;
    --danger-bg: #5c1b1b;
    /* Capture buttons. They are only live on the running (pale) half and
       only resting on a dark one, so each state has one surface to clear. */
    --cap-line: #6b7787;    /* 3.6:1 on a waiting half */
    --cap-ink: #c3cad4;
    --cap-dim: #aab3bf;
    --mono: 'Source Code Pro', ui-monospace, SFMono-Regular, monospace;
    --sans: 'Source Sans 3', system-ui, -apple-system, sans-serif;
    --radius: 12px;
    --tap: 56px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { color-scheme: dark; -webkit-text-size-adjust: 100%; }
  html, body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  /* No pinch, no double-tap zoom, no panning anywhere on the clock. The
     settings sheet re-enables vertical panning for itself below. iOS Safari
     still needs the gesture guard in charles-clock.ts. */
  html, body { touch-action: none; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    -webkit-user-select: none; user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }
  .num { font-variant-numeric: tabular-nums; font-feature-settings: 'tnum' 1; }
  .eyebrow {
    font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase;
    font-weight: 700;
  }
  [hidden] { display: none !important; }

  .app {
    height: 100vh;          /* fallback for browsers without dvh */
    height: 100dvh;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto minmax(0, 1fr);
    padding: env(safe-area-inset-top) env(safe-area-inset-right)
             env(safe-area-inset-bottom) env(safe-area-inset-left);
  }
  .app.cols {
    grid-template-rows: minmax(0, 1fr);
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  }

  /* ── Player halves ─────────────────────────────── */
  /* The half is the tap target. Its inner box is absolutely centred and
     rotated to face its player; --iw/--ih are set from JS because a quarter
     turn swaps the axes. */
  .side {
    --ink: var(--text-dim);
    --ink-strong: #dfe4ea;
    --ink-inc: var(--inc);
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
    color: var(--ink);
    cursor: pointer;
    touch-action: none;
    transition: background 0.18s ease;
  }
  .side-inner {
    position: absolute;
    top: 50%; left: 50%;
    width: var(--iw, 100%);
    height: var(--ih, 100%);
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
    container-type: size;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    gap: clamp(6px, 2.2cqh, 20px);
    padding: 12px 14px;
    padding: clamp(8px, 2cqh, 20px) 14px;
  }
  .side.quarter .side-inner { flex-direction: column-reverse; }

  /* The digits are the product: as big as the half allows. "0:09.5" and
     "1:59" fit at 25cqw; an hour-plus "1:00:00" drops to 21cqw (.long). */
  .time {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(52px, 15vmin, 200px);   /* fallback: no container units */
    font-size: clamp(52px, min(32cqh, 25cqw), 200px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink-strong);
    transition: color 0.18s ease;
  }
  .time.long { font-size: clamp(44px, min(32cqh, 21cqw), 170px); }

  .meta {
    display: flex; align-items: baseline; gap: 6px 14px;
    flex-wrap: wrap; justify-content: center;
    min-height: 24px;
  }
  .who { font-weight: 700; font-size: 1.2rem; color: var(--ink-strong); }
  .chip { display: flex; align-items: baseline; gap: 6px; }
  .chip .num { font-family: var(--mono); font-size: 1.2rem; font-weight: 700; color: var(--ink-strong); }
  .chip-inc .num { color: var(--ink-inc); }
  .chip-flag { font-weight: 700; font-size: 1rem; color: var(--danger); letter-spacing: 0.03em; }

  /* The hint keeps its box when silent, so nothing moves when play starts. */
  .hint {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    text-align: center; min-height: 2.6em;
  }
  .hint.hint-off { visibility: hidden; }
  .hint-main { font-size: 1.1rem; font-weight: 700; color: var(--ink-strong); }
  .hint-sub { font-size: 0.95rem; color: var(--ink); }

  /* On move but not running: before the first tap, or paused. */
  .side.turn { --ink-strong: #fff; }
  .side.turn .time { color: #fff; }
  /* Running: the light half. */
  .side.ticking {
    --ink: var(--live-dim);
    --ink-strong: var(--live-ink);
    --ink-inc: var(--live-inc);
    background: var(--live-bg);
  }
  .side.ticking .time { color: var(--live-ink); }
  .side.low {
    --ink: #5c1a0e;
    --ink-strong: var(--low-ink);
    --ink-inc: #0f3f73;
    background: var(--low-bg);
    animation: blink 0.85s ease-in-out infinite alternate;
  }
  .side.low .time { color: var(--low-ink); }
  .side.flagged { --ink: #ffc9c9; --ink-strong: #fff; background: var(--danger-bg); animation: none; }
  .side.flagged .time { color: var(--danger); }

  @keyframes blink { from { background: var(--low-bg); } to { background: var(--low-bg-blink); } }
  @media (prefers-reduced-motion: reduce) {
    .side.low { animation: none; }
  }

  /* ── Capture buttons ──────────────────────────── */
  /* Far edge of each half — a natural slap lands on the digits instead. */
  .captures { display: flex; gap: 10px; width: 100%; max-width: 460px; }
  .cap {
    flex: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    padding: 8px 6px;
    min-height: 64px;
    min-height: max(64px, 16cqh);
    background: var(--bg-input);
    /* Resting, the boundary has to be the border: near black a small fill
       step reads as nothing. #6b7787 clears WCAG 1.4.11's 3:1. */
    border: 1.5px solid var(--cap-line);
    border-radius: var(--radius);
    color: var(--cap-ink);
    font: inherit;
    cursor: pointer;
    touch-action: none;
    transition: background 0.1s, transform 0.06s;
  }
  /* pointer-events:none, not just :disabled — a disabled button swallows the
     tap instead of letting it reach the half underneath, which would leave
     three dead zones in the middle of the slap area. */
  /* No opacity here: these rest disabled whenever the other side's clock
     runs, so this is the state you look at most. */
  .cap:disabled { cursor: default; pointer-events: none; }
  /* Live only on the running half: white faces with a dark rim on pale green. */
  .cap:not(:disabled) { background: #fff; border: 2px solid var(--live-line); color: var(--live-ink); }
  .cap:not(:disabled):active { transform: scale(0.95); background: var(--live-ink); color: #fff; }
  /* The piece is the decision; the seconds just have to happen. Size accordingly. */
  .cap-piece { font-size: 2rem; font-size: clamp(1.9rem, 6.5cqh, 2.8rem); line-height: 1; }
  .cap-add { font-family: var(--mono); font-size: 0.9rem; font-weight: 700; color: var(--cap-dim); }
  .cap:not(:disabled) .cap-add { color: var(--live-inc); }
  .cap:not(:disabled):active .cap-add { color: #fff; }

  .chip-inc .num.bump { animation: bump 0.55s ease-out; }
  @keyframes bump {
    0% { transform: scale(1); }
    30% { transform: scale(1.45); }
    100% { transform: scale(1); }
  }

  /* ── Control bar ──────────────────────────────── */
  .bar {
    display: flex; align-items: stretch; justify-content: space-evenly;
    gap: 10px; padding: 8px 10px;
    background: var(--bg);
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
  }
  .app.cols .bar {
    flex-direction: column;
    border: none;
    border-left: 1px solid var(--border); border-right: 1px solid var(--border);
    padding: 10px 8px;
    min-height: 0;
  }
  /* In landscape the bar is a column as tall as the screen, so the buttons
     share its height instead of demanding 56px each. */
  .app.cols .ctl { min-height: 0; min-width: 56px; flex-grow: 1; }
  @media (max-height: 460px) {
    .app.cols .bar { gap: 8px; padding: 8px 6px; }
    .app.cols .ctl-text { display: none; }
  }
  .ctl {
    flex: 1 1 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    min-height: var(--tap); min-width: 0;
    padding: 6px 4px;
    background: var(--bg-input);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font: inherit;
    cursor: pointer;
    transition: background 0.12s, color 0.12s, transform 0.06s;
  }
  .ctl:active:not(:disabled) { transform: scale(0.96); background: var(--border); }
  /* Disabled loses its fill but stays readable (5:1), so players can see
     the control exists and why nothing happens. */
  .ctl:disabled { background: transparent; border-color: #262b33; color: #7d8691; cursor: default; }
  .ctl:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* The most-pressed control gets the most room ("Resume", "New game"). */
  .ctl-primary { flex-grow: 1.5; background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 700; }
  .ctl-primary:active:not(:disabled) { background: var(--accent-hover); }
  .ctl.armed, .ctl.armed:active:not(:disabled) { background: var(--danger-bg); border-color: var(--danger); color: #fff; }
  .ctl-dim { background: var(--bg-input); }
  .ctl-icon { display: block; width: 24px; height: 24px; }
  .ctl-icon svg { width: 100%; height: 100%; display: block; }
  .icon-pause { display: none; }
  .app.running .ctl-primary .icon-play { display: none; }
  .app.running .ctl-primary .icon-pause { display: block; }
  .ctl-text { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.01em; white-space: nowrap; }
  @media (max-width: 380px) { .ctl-text { font-size: 0.78rem; } }
  .ctl.urgent { animation: urgent 0.9s ease-in-out infinite alternate; border-color: var(--accent); }
  @keyframes urgent { from { box-shadow: 0 0 0 0 rgba(95,147,204,0); } to { box-shadow: 0 0 0 4px rgba(95,147,204,0.45); } }
  @media (prefers-reduced-motion: reduce) { .ctl.urgent { animation: none; } }

  /* ── Settings sheet ───────────────────────────── */
  .sheet-backdrop {
    position: fixed; inset: 0; z-index: 50;
    background: rgba(0,0,0,0.7);
    display: flex; align-items: flex-end; justify-content: center;
  }
  .sheet {
    width: 100%; max-width: 560px; max-height: 94dvh; overflow-y: auto;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 18px 18px 0 0;
    padding: 20px 20px 0;
    -webkit-user-select: text; user-select: text;
    overscroll-behavior: contain;
    touch-action: pan-y;
  }
  .sheet ::selection { background: var(--accent); color: var(--accent-ink); }
  .sheet h2 { font-size: 1.35rem; margin-bottom: 8px; }
  .sheet h3 { font-size: 1.1rem; margin: 22px 0 12px; }
  .help { color: var(--text-dim); font-size: 1rem; line-height: 1.5; margin-bottom: 12px; }
  .help strong { color: var(--text); }
  .rules { list-style: none; color: var(--text-dim); font-size: 1rem; line-height: 1.5; margin-bottom: 8px; }
  .rules li { position: relative; padding-left: 17px; margin-bottom: 9px; }
  .rules li::before {
    content: '';
    position: absolute; left: 2px; top: 0.6em;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--text-dim);
  }
  .rules strong { color: var(--text); font-weight: 700; }
  .sheet label { display: flex; flex-direction: column; gap: 4px; font-size: 0.9rem; color: var(--text-dim); margin-bottom: 14px; }
  .sheet input[type="number"] {
    font: inherit; font-family: var(--mono); font-size: 1.1rem;
    padding: 12px;
