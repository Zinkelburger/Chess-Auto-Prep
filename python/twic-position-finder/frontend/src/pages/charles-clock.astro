  .chip-inc .num { color: var(--accent); font-weight: 700; }
  .chip-flag {
    font-weight: 700; font-size: 0.85rem; color: var(--danger);
    letter-spacing: 0.04em;
  }
  .hint { font-size: 0.95rem; color: var(--text-dim); opacity: 0.85; }

  .side.turn .time { color: var(--text); }
