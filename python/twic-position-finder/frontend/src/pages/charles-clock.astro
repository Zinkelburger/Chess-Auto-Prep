---
// Charles Clock — Charles Woodruff's "endgame blitz" chess clock.
//
// Both players start with a short time control. When you capture a piece you
// may hit the clock with a capture button instead of the plain zone, which
// permanently adds seconds to a cumulative increment that BOTH players then
// receive on every move. Heavier piece → bigger increment. Ported from the
// Excel/VBA prototype ("EndGain Clock Update.xlsm").
//
// The workbook is the authority on the rules, and it settles two questions the
// UI has to answer: the increment is a single shared counter (VBA mCumAddback,
// one cell labelled "Total cumulative increment:", paid to whichever clock is
// running at each hit — so both players receive every raise), and the ladder is
// 2/4/6 for knight-or-bishop/rook/queen, per the sheet's own button captions.
// Charles's original written prompt asked for 3/6/9; the workbook supersedes it.
//
// Phone ergonomics follow lichess mobile's clock tool: the whole half is the
// tap target, hits fire on pointerdown, controls that could ruin a game are
// disabled while the clock ticks, and the screen is kept awake. Two places we
// go further, because our capture hit is the one irreversible action: every
// hit is undoable, and the capture buttons sit at the far edge of each half
// (a natural slap lands on the big digits) and are `disabled` unless it is
// that side's turn, so a stray tap falls through to a plain hit.

import ClockSide from '../components/ClockSide.astro';

const ICON = {
  play: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>',
  pause: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.4v14H7zM13.6 5H17v14h-3.4z"/></svg>',
  undo: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-4"/></svg>',
  reset: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><path d="M20 3v5h-5"/></svg>',
  tune: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 8h9M18.5 8H21M3 16h4.5M14 16h7"/><circle cx="15" cy="8" r="2.6"/><circle cx="10" cy="16" r="2.6"/></svg>',
  flip: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4 4 7l3 3"/><path d="M4 7h16"/><path d="m17 14 3 3-3 3"/><path d="M20 17H4"/></svg>',
  full: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5"/><path d="M20 9V4h-5"/><path d="M4 15v5h5"/><path d="M20 15v5h-5"/></svg>',
};

---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Charles Clock" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="theme-color" content="#171a1f" />
  <meta name="description" content="Charles Clock — blitz that ends in real endgames. Capturing a piece permanently raises the increment for both players." />
  <link rel="manifest" href="/charles-clock.webmanifest" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⏱</text></svg>" />
  <link rel="apple-touch-icon" href="/charles-clock-192.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Code+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <title>Charles Clock — Chess Auto Prep</title>
</head>
<body>
  <div id="app" class="app">

    <ClockSide side="top" name="Player 1" />

    <div class="bar">
      <button class="ctl ctl-primary" data-action="startpause" type="button" aria-label="Start">
        <span class="ctl-icon icon-play" set:html={ICON.play} />
        <span class="ctl-icon icon-pause" set:html={ICON.pause} />
        <span class="ctl-text" data-primary-label>Start</span>
      </button>
      <button class="ctl" data-action="undo" type="button" disabled aria-label="Undo last clock hit">
        <span class="ctl-icon" set:html={ICON.undo} /><span class="ctl-text">Undo</span>
      </button>
      <button class="ctl" data-action="reset" type="button" aria-label="Reset the clock">
        <span class="ctl-icon" set:html={ICON.reset} /><span class="ctl-text">Reset</span>
      </button>
      <button class="ctl" data-action="settings" type="button" aria-label="Settings">
        <span class="ctl-icon" set:html={ICON.tune} /><span class="ctl-text">Setup</span>
      </button>
      <button class="ctl" data-action="flip" type="button" aria-label="Swap the two players' sides">
        <span class="ctl-icon" set:html={ICON.flip} /><span class="ctl-text">Flip</span>
      </button>
      <button class="ctl" data-action="fullscreen" type="button" hidden aria-label="Toggle fullscreen">
        <span class="ctl-icon" set:html={ICON.full} /><span class="ctl-text">Full</span>
      </button>
    </div>

    <ClockSide side="bottom" name="Player 2" />

    <!-- Settings sheet -->
    <div class="sheet-backdrop" data-sheet hidden>
      <div class="sheet" role="dialog" aria-modal="true" aria-labelledby="settings-title">
        <h2 id="settings-title">Charles Clock</h2>
        <p class="help">Blitz that ends in a real endgame instead of a scramble.</p>
        <ul class="rules">
          <li><strong>Hit your own side</strong> to end your move.</li>
          <li><strong>Captured a piece?</strong> Hit that piece's button instead. It ends
            your move <em>and</em> raises the increment. Bigger piece, bigger raise.</li>
          <li><strong>The increment is shared.</strong> Both players get it, on every move,
            for the rest of the game.</li>
          <li><strong>Raises stack and never come back down.</strong> Trade queens and
            that is <span class="num">+<span data-queen-trade>12</span>s</span> a move from
            then on — one raise each.</li>
          <li><strong>The capture buttons are optional.</strong> You can always just hit
            your own side instead.</li>
        </ul>

        <form data-settings-form>
          <fieldset class="presets">
            <legend>Start time</legend>
            <div class="chips">
              {[1, 2, 3, 5, 10].map((m) => (
                <button type="button" class="preset" data-preset-min={m}>{m} min</button>
              ))}
            </div>
          </fieldset>

          <div class="grid2">
            <label>Start time (minutes)
              <input type="number" name="minutes" min="0.25" max="180" step="0.25" inputmode="decimal" required />
            </label>
            <label>Base increment (s)
              <input type="number" name="base" min="0" max="60" step="1" inputmode="numeric" required />
            </label>
          </div>

          <fieldset class="presets">
            <legend>Capture ladder</legend>
            <div class="chips">
              <button type="button" class="preset" data-preset-ladder="1,2,3">Gentle 1/2/3</button>
              <button type="button" class="preset" data-preset-ladder="2,4,6">Classic 2/4/6</button>
              <button type="button" class="preset" data-preset-ladder="3,6,10">Steep 3/6/10</button>
            </div>
          </fieldset>

          <div class="grid3">
            <label>♘♗ adds
              <input type="number" name="minor" min="0" max="60" step="1" inputmode="numeric" required />
            </label>
            <label>♖ adds
              <input type="number" name="rook" min="0" max="60" step="1" inputmode="numeric" required />
            </label>
            <label>♕ adds
              <input type="number" name="queen" min="0" max="60" step="1" inputmode="numeric" required />
            </label>
          </div>

          <label class="check">
            <input type="checkbox" name="sound" /> Sound on hit, low time &amp; flag
          </label>
          <label class="check">
            <input type="checkbox" name="facing" /> Face the players (rotate the far side 180°)
          </label>

          <div class="sheet-actions">
            <button type="button" class="ctl ctl-wide ctl-dim" data-action="settings-cancel">Cancel</button>
            <button type="submit" class="ctl ctl-wide ctl-primary">Save &amp; reset</button>
          </div>
        </form>

        <p class="credit">
          Concept by Charles Woodruff. Keys: <kbd>space</kbd> pause · <kbd>↑</kbd><kbd>↓</kbd> hit · <kbd>u</kbd> undo · <kbd>f</kbd> swap sides.
          <a href="/">Chess Auto Prep</a>
        </p>
      </div>
    </div>
  </div>

  <script>
    import { initCharlesClock } from '../lib/charles-clock';
    initCharlesClock();
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #171a1f;
    --bg-card: #1f242b;
    --bg-input: #262c35;
    --border: #39414c;
    --text: #e6e9ee;
    --text-dim: #9aa4b2;
    --accent: #5f93cc;
    --accent-hover: #7fb0ea;
    --accent-ink: #1d2229;
    --ok: #6cc79a;
    --turn-bg: #26372a;
    --low-bg: #4a2a24;
    --low-bg-blink: #6d2f26;
    --danger: #e08585;
    --danger-bg: #3a2020;
    /* Capture buttons. Solid glyphs on a dark half need explicit
       colours, not opacity — see the .cap block below. */
    --cap-line: #6b7787;    /* 3.43:1 on the idle half */
    --cap-ink: #adb6c2;     /* glyph, resting — APCA Lc 58 */
    --cap-dim: #98a2b0;     /* +Ns, resting — Lc 47 */
    --cap-on-bg: #2b3a4d;   /* enabled face */
    --cap-on-dim: #9dc0e8;  /* +Ns, enabled — Lc 59 */
    --mono: 'Source Code Pro', ui-monospace, SFMono-Regular, monospace;
    --sans: 'Source Sans 3', system-ui, -apple-system, sans-serif;
    --radius: 12px;
    --tap: 56px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { color-scheme: dark; -webkit-text-size-adjust: 100%; }
  html, body { height: 100%; overflow: hidden; overscroll-behavior: none; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .num { font-variant-numeric: tabular-nums; font-feature-settings: 'tnum' 1; }
  .eyebrow {
    font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--text-dim); font-weight: 600;
  }
  [hidden] { display: none !important; }

  .app {
    height: 100vh;          /* fallback for browsers without dvh */
    height: 100dvh;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .app.cols { grid-template-rows: none; grid-template-columns: 1fr auto 1fr; }

  /* ── Player halves ─────────────────────────────── */
  /* The half is the tap target. Its inner box is absolutely centred and
     rotated to face its player; --iw/--ih are set from JS because a quarter
     turn swaps the axes. */
  .side {
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
    cursor: pointer;
    touch-action: none;
    transition: background 0.18s ease;
  }
  .side-inner {
    position: absolute;
    top: 50%; left: 50%;
    width: var(--iw, 100%);
    height: var(--ih, 100%);
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg));
    container-type: size;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    gap: clamp(6px, 2cqh, 18px);
    padding: 12px 14px;
    padding: clamp(8px, 2cqh, 20px) 14px;
  }
  .side.quarter .side-inner { flex-direction: column-reverse; }

  .time {
    font-family: var(--mono);
    font-weight: 600;
    font-size: clamp(44px, 13vmin, 150px);   /* fallback: no container units */
    font-size: clamp(44px, min(30cqh, 19cqw), 150px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-dim);
    transition: color 0.18s ease;
  }

  .meta {
    display: flex; align-items: center; gap: 10px;
    flex-wrap: wrap; justify-content: center;
    min-height: 22px;
  }
  .who { font-weight: 700; font-size: 1.05rem; color: var(--text-dim); }
  .chip { display: flex; align-items: baseline; gap: 5px; }
  .chip .num { font-family: var(--mono); font-size: 1.05rem; font-weight: 600; color: var(--text-dim); }
  .chip-inc .num { color: var(--accent); font-weight: 700; }
  .chip-flag {
    font-weight: 700; font-size: 0.85rem; color: var(--danger);
    letter-spacing: 0.04em;
  }
  .hint { font-size: 0.95rem; color: var(--text-dim); opacity: 0.85; }

  .side.turn .time { color: var(--text); }
  .side.ticking { background: var(--turn-bg); }
  .side.ticking .who { color: var(--ok); }
  .side.ticking .time { color: #fff; }
  .side.low { background: var(--low-bg); animation: blink 0.85s ease-in-out infinite alternate; }
  .side.low .time { color: #ffc4b8; }
  .side.flagged { background: var(--danger-bg); animation: none; }
  .side.flagged .time { color: var(--danger); }
  .side.flagged .who { color: var(--danger); }

  @keyframes blink { from { background: var(--low-bg); } to { background: var(--low-bg-blink); } }
  @media (prefers-reduced-motion: reduce) {
    .side.low { animation: none; }
  }

  /* ── Capture buttons ──────────────────────────── */
  /* Far edge of each half — a natural slap lands on the digits instead. */
  .captures { display: flex; gap: 10px; width: 100%; max-width: 460px; }
  .cap {
    flex: 1;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    padding: 8px 6px;
    min-height: 64px;
    min-height: max(64px, 16cqh);
    background: var(--bg-input);
    /* The half behind these moves (grey → green → red), and near black a
       small luminance step reads as nothing — no fill separates the button
       from its half. The boundary has to be the border: #6b7787 is 3.43:1 on
       the idle half, clearing WCAG 1.4.11's 3:1 for a control boundary. */
    border: 1.5px solid var(--cap-line);
    border-radius: var(--radius);
    color: var(--cap-ink);
    font: inherit;
    cursor: pointer;
    touch-action: none;
    transition: background 0.1s, transform 0.06s;
  }
  /* pointer-events:none, not just :disabled — a disabled button swallows the
     tap instead of letting it reach the half underneath, which would leave
     three dead zones in the middle of the slap area. */
  /* No opacity here: these are disabled whenever the other side's clock runs,
     so this is the state you look at most, and fading the whole button put the
     glyph at APCA Lc 17 (15 is invisible) and the label and border at Lc 0.
     The resting colours above already read — enabled adds accent, it doesn't
     rescue legibility. */
  .cap:disabled { cursor: default; pointer-events: none; }
  /* Accent means "you can hit this right now", nothing else. */
  .cap:not(:disabled) { background: var(--cap-on-bg); border-color: var(--accent); color: #fff; }
  .cap:not(:disabled):active { transform: scale(0.95); background: var(--accent); color: var(--accent-ink); }
  /* The piece is the decision; the seconds just have to happen. Size accordingly. */
  .cap-piece { font-size: 2rem; font-size: clamp(1.9rem, 6cqh, 2.6rem); line-height: 1; }
  .cap-add { font-family: var(--mono); font-size: 0.8rem; font-weight: 700; color: var(--cap-dim); }
  .cap:not(:disabled) .cap-add { color: var(--cap-on-dim); }
  .cap:not(:disabled):active .cap-add { color: var(--accent-ink); }

  .chip-inc .num.bump { animation: bump 0.55s ease-out; }
  @keyframes bump {
    0% { transform: scale(1); }
    30% { transform: scale(1.45); color: var(--accent-hover); }
    100% { transform: scale(1); }
  }

  /* ── Control bar ──────────────────────────────── */
  .bar {
    display: flex; align-items: stretch; justify-content: space-evenly;
    gap: 6px; padding: 8px 10px;
    background: var(--bg);
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
  }
  .app.cols .bar {
    flex-direction: column;
    border: none;
    border-left: 1px solid var(--border); border-right: 1px solid var(--border);
    padding: 10px 8px;
  }
  .ctl {
    flex: 1 1 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    min-height: var(--tap); min-width: 0;
    padding: 6px 4px;
    background: var(--bg-input);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font: inherit;
    cursor: pointer;
    transition: background 0.12s, opacity 0.12s, transform 0.06s;
  }
  .ctl:active:not(:disabled) { transform: scale(0.96); background: var(--border); }
  .ctl:disabled { opacity: 0.32; cursor: default; }
  .ctl:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ctl-primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 700; }
  .ctl-primary:active:not(:disabled) { background: var(--accent-hover); }
  .ctl-dim { background: var(--bg-input); }
  .ctl-icon { display: block; width: 24px; height: 24px; }
  .ctl-icon svg { width: 100%; height: 100%; display: block; }
  .icon-pause { display: none; }
  .app.running .ctl-primary .icon-play { display: none; }
  .app.running .ctl-primary .icon-pause { display: block; }
  .ctl-text { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.03em; }
  .ctl.urgent { animation: urgent 0.9s ease-in-out infinite alternate; border-color: var(--accent); }
  @keyframes urgent { from { box-shadow: 0 0 0 0 rgba(95,147,204,0); } to { box-shadow: 0 0 0 4px rgba(95,147,204,0.35); } }
  @media (prefers-reduced-motion: reduce) { .ctl.urgent { animation: none; } }

  /* ── Settings sheet ───────────────────────────── */
  .sheet-backdrop {
    position: fixed; inset: 0; z-index: 50;
    background: rgba(0,0,0,0.66);
    display: flex; align-items: flex-end; justify-content: center;
  }
  .sheet {
    width: 100%; max-width: 560px; max-height: 94dvh; overflow-y: auto;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 18px 18px 0 0;
    padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
    -webkit-user-select: text; user-select: text;
    overscroll-behavior: contain;
  }
  .sheet h2 { font-size: 1.3rem; margin-bottom: 8px; }
  .help { color: var(--text-dim); font-size: 0.9rem; line-height: 1.5; margin-bottom: 12px; }
  .help strong { color: var(--text); }
  .rules { list-style: none; color: var(--text-dim); font-size: 0.9rem; line-height: 1.5; margin-bottom: 18px; }
  .rules li { position: relative; padding-left: 17px; margin-bottom: 9px; }
  .rules li::before {
    content: '';
    position: absolute; left: 2px; top: 0.55em;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent);
  }
  .rules strong { color: var(--text); font-weight: 600; }
  .sheet label { display: flex; flex-direction: column; gap: 4px; font-size: 0.82rem; color: var(--text-dim); margin-bottom: 14px; }
  .sheet input[type="number"] {
    font: inherit; font-family: var(--mono); font-size: 1.05rem;
    padding: 12px;
    background: var(--bg-input); color: var(--text);
    border: 1px solid var(--border); border-radius: 8px;
    min-height: 48px;
  }
  .sheet input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .presets { border: none; margin-bottom: 12px; }
  .presets legend { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); font-weight: 600; margin-bottom: 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .preset {
    min-height: 44px; padding: 8px 14px;
    background: var(--bg-input); color: var(--text);
    border: 1px solid var(--border); border-radius: 999px;
    font: inherit; font-size: 0.85rem; font-weight: 600; cursor: pointer;
  }
  .preset:active { background: var(--accent); color: var(--accent-ink); }
  .check { flex-direction: row !important; align-items: center; gap: 10px !important; color: var(--text) !important; font-size: 0.9rem !important; min-height: 44px; }
  .check input { width: 22px; height: 22px; accent-color: var(--accent); flex: none; }
  .sheet-actions { display: flex; gap: 10px; margin-top: 14px; }
  .ctl-wide { flex-direction: row; gap: 0; padding: 12px 18px; font-size: 0.95rem; font-weight: 700; }
  .credit { margin-top: 18px; font-size: 0.75rem; line-height: 1.7; color: var(--text-dim); text-align: center; }
  .credit a { color: var(--accent); }
  kbd {
    font-family: var(--mono); font-size: 0.72rem;
    background: var(--bg-input); border: 1px solid var(--border);
    border-radius: 4px; padding: 1px 5px;
  }
</style>
