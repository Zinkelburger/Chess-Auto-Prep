  .ctl:active:not(:disabled) { transform: scale(0.96); background: var(--border); }
  .ctl:disabled { opacity: 0.32; cursor: default; }
  .ctl:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ctl-primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 700; }
  .ctl-primary:active:not(:disabled) { background: var(--accent-hover); }
  .ctl-dim { background: var(--bg-input); }
  .ctl-icon { display: block; width: 24px; height: 24px; }
  .ctl-icon svg { width: 100%; height: 100%; display: block; }
  .icon-pause { display: none; }
  .app.running .ctl-primary .icon-play { display: none; }
  .app.running .ctl-primary .icon-pause { display: block; }
  .ctl-text { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.03em; }
  .ctl.urgent { animation: urgent 0.9s ease-in-out infinite alternate; border-color: var(--accent); }
  @keyframes urgent { from { box-shadow: 0 0 0 0 rgba(95,147,204,0); } to { box-shadow: 0 0 0 4px rgba(95,147,204,0.35); } }
  @media (prefers-reduced-motion: reduce) { .ctl.urgent { animation: none; } }

  /* ── Settings sheet ───────────────────────────── */
  .sheet-backdrop {
    position: fixed; inset: 0; z-index: 50;
