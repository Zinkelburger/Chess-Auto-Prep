---
// Shared shell for every page except the Charles Clock, which is a full-screen
// app with its own <html>. Holds only what all pages use: design tokens, the
// nav, and the primitive vocabulary (buttons, inputs, cards, alerts, chips).
// Page-specific styling lives next to the page.
interface Props {
  title: string;
  wide?: boolean;
  description?: string;
}
const {
  title,
  wide = false,
  description = 'Chess Auto Prep — TWIC alerts, a tactics trainer built from your own games, and the Charles Clock.',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const NAV = [
  { href: '/twic-notifications', label: 'TWIC Alerts', match: ['/twic-notifications', '/dashboard', '/verify', '/unsubscribe'] },
  { href: '/tactics', label: 'Tactics Trainer', match: ['/tactics'] },
  { href: '/charles-clock', label: 'Charles Clock', match: ['/charles-clock'] },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#171a1f" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>♟</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Code+Pro:wght@400;600;700&display=swap" rel="stylesheet" />
  <title>{title} — Chess Auto Prep</title>
</head>
<body>
  <nav class="site-nav" aria-label="Site">
    <div class="nav-inner">
      <a href="/" class="nav-logo"><span aria-hidden="true">♟</span> Chess Auto Prep</a>
      <div class="nav-links">
        {NAV.map((item) => (
          <a
            href={item.href}
            class:list={[{ active: item.match.includes(path) }]}
            aria-current={item.match.includes(path) ? 'page' : undefined}
          >{item.label}</a>
        ))}
      </div>
    </div>
  </nav>
  <main id="content" class:list={[{ wide }]}>
    <slot />
  </main>
  <footer class="site-footer">
    <span>Chess Auto Prep</span>
    <span class="sep" aria-hidden="true">·</span>
    <a href="https://theweekinchess.com/" target="_blank" rel="noopener">The Week in Chess</a>
    <span class="sep" aria-hidden="true">·</span>
    <a href="https://github.com/Zinkelburger/Chess-Auto-Prep" target="_blank" rel="noopener">Source</a>
  </footer>
</body>
</html>

<style is:global>
  /* ── Tokens ────────────────────────────────────────────────────────
     Shared with docs/design/wireframe-style.css and the Charles Clock:
     dark-only, slightly blue-grey neutrals, one muted steel-blue accent. */
  :root {
    --bg: #171a1f;
    --bg-card: #1f242b;
    --bg-input: #262c35;
    --bg-raised: #2b323c;
    --border: #39414c;
    --border-strong: #4a5462;
    --text: #e6e9ee;
    --text-dim: #9aa4b2;
    --text-faint: #6f7987;
    --accent: #5f93cc;
    --accent-hover: #7fb0ea;
    --accent-rgb: 95, 147, 204;
    --accent-bg: #1c2a3b;
    --accent-ink: #1d2229;
    --pick: #7fb0ea;
    --pick-bg: #1e2f44;
    --ok: #6cc79a;
    --ok-bg: #1c332a;
    --warn: #e6c069;
    --warn-bg: #3a3218;
    --danger: #e08585;
    --danger-bg: #3a2020;
    --mono: 'Source Code Pro', ui-monospace, SFMono-Regular, monospace;
    --sans: 'Source Sans 3', system-ui, -apple-system, sans-serif;
    --radius: 8px;
    --radius-lg: 12px;
    --shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.5);
    --nav-h: 56px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { font-size: 16px; color-scheme: dark; -webkit-text-size-adjust: 100%; }
  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    line-height: 1.55;
  }
  [hidden] { display: none !important; }
  h1, h2, h3 { text-wrap: balance; line-height: 1.2; }
  h1 { font-size: 1.85rem; font-weight: 700; letter-spacing: -0.015em; }
  h2 { font-size: 1.3rem; font-weight: 700; }
  h3 { font-size: 1.05rem; font-weight: 600; }
  p { text-wrap: pretty; }
  a { color: var(--accent); }
  a:hover { color: var(--accent-hover); }
  code, .mono { font-family: var(--mono); font-size: 0.88em; }
  .num, .tabular { font-variant-numeric: tabular-nums; font-feature-settings: 'tnum' 1; }
  .eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
    font-weight: 600;
  }
  .dim { color: var(--text-dim); }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  ::selection { background: var(--accent-bg); }

  /* ── Navigation ─────────────────────────────────────────────────── */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-card) 92%, transparent);
    backdrop-filter: blur(10px);
  }
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    gap: 16px;
  }
  .nav-logo {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .nav-logo:hover { color: var(--text); }
  .nav-links { display: flex; gap: 4px; }
  .nav-links a {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-dim);
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 6px;
    white-space: nowrap;
    transition: color 0.15s, background 0.15s;
  }
  .nav-links a:hover { color: var(--text); background: rgba(255, 255, 255, 0.05); }
  .nav-links a.active { color: var(--accent); background: var(--accent-bg); }
  @media (max-width: 560px) {
    .nav-inner { flex-direction: column; height: auto; padding: 10px 16px; gap: 6px; }
    .nav-links a { font-size: 0.82rem; padding: 5px 10px; }
  }

  /* ── Main / footer ───────────────────────────────────────────────── */
  main { flex: 1; width: 100%; max-width: 900px; margin: 0 auto; padding: 36px 24px 56px; }
  main.wide { max-width: 1100px; }
  @media (max-width: 560px) { main { padding: 20px 16px 40px; } }
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 18px 24px;
    font-size: 0.78rem;
    color: var(--text-faint);
    text-align: center;
  }
  .site-footer a { color: var(--text-dim); text-decoration: none; }
  .site-footer a:hover { color: var(--text); }
  .site-footer .sep { margin: 0 8px; }

  /* ── Page header ────────────────────────────────────────────────── */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .page-header h1 { margin-bottom: 6px; }
  .page-header-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; flex-wrap: wrap; }
  .lede { color: var(--text-dim); font-size: 1.02rem; max-width: 42em; }
  .lede a { text-decoration: none; }
  .lede a:hover { text-decoration: underline; }

  /* ── Card ───────────────────────────────────────────────────────── */
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    margin-bottom: 16px;
  }
  .card > h2 { font-size: 1.15rem; margin-bottom: 14px; }
  .card-lead { color: var(--text-dim); font-size: 0.92rem; margin: -6px 0 16px; }
  .empty-state { text-align: center; padding: 48px 28px; }
  .empty-title { font-size: 1.15rem; font-weight: 600; margin-bottom: 8px; }
  .empty-copy { color: var(--text-dim); font-size: 0.92rem; max-width: 30em; margin: 0 auto; }

  /* Centered status panel (verify / unsubscribe / sign-in gate). */
  .status-panel { text-align: center; padding: 56px 0; max-width: 460px; margin: 0 auto; }
  .status-panel h1 { margin-bottom: 8px; }
  .status-panel .lede { margin: 0 auto 22px; }
  .status-panel .btn-row { justify-content: center; }
  .status-icon { font-size: 2.6rem; line-height: 1; margin-bottom: 14px; }
  .status-icon.ok { color: var(--ok); }
  .status-icon.bad { color: var(--danger); }

  /* ── Forms ──────────────────────────────────────────────────────── */
  input, select, textarea {
    font-family: var(--sans);
    font-size: 0.92rem;
    background: var(--bg-input);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 6px;
    width: 100%;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  input:focus, select:focus, textarea:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.18);
  }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: none; }
  input::placeholder { color: var(--text-faint); }
  input[type="number"] { font-family: var(--mono); }
  input:disabled, select:disabled { opacity: 0.55; cursor: not-allowed; }
  label, .field-label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 6px;
    font-weight: 500;
  }
  .optional { font-size: 0.75rem; color: var(--text-faint); font-weight: 400; margin-left: 4px; }
  .form-row { margin-bottom: 16px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 16px; }
  @media (max-width: 600px) { .form-grid { grid-template-columns: 1fr; } }
  .form-actions, .btn-row { display: flex; gap: 10px; margin-top: 8px; flex-wrap: wrap; align-items: center; }
  .inline-form { display: flex; gap: 12px; align-items: flex-end; }
  .inline-form .grow { flex: 1; margin-bottom: 0; }
  .inline-form .btn { flex-shrink: 0; }
  @media (max-width: 560px) { .inline-form { flex-direction: column; align-items: stretch; } }
  .hint { font-size: 0.8rem; color: var(--text-faint); margin-top: 6px; }

  .checkbox-label {
    display: flex; align-items: center; gap: 9px;
    cursor: pointer; font-size: 0.9rem; color: var(--text-dim); user-select: none;
    margin-bottom: 0;
  }
  .checkbox-label input[type="checkbox"] {
    width: 18px; height: 18px; min-width: 18px; accent-color: var(--accent); cursor: pointer;
  }

  /* Choice chips — a checkbox/radio group rendered as pills. */
  .choice-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .choice { display: inline-flex; cursor: pointer; user-select: none; position: relative; }
  .choice input { position: absolute; opacity: 0; pointer-events: none; width: 1px; height: 1px; }
  .choice span {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-dim);
    background: var(--bg-input);
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .choice:hover span { border-color: var(--border-strong); color: var(--text); }
  .choice input:checked + span {
    background: var(--pick-bg);
    border-color: var(--pick);
    color: var(--text);
    font-weight: 600;
  }
  .choice input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ── Buttons ────────────────────────────────────────────────────── */
  button { font: inherit; color: inherit; }
  .btn {
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 6px;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    line-height: 1.2;
    white-space: nowrap;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s, opacity 0.15s;
  }
  .btn:disabled, .btn[aria-disabled="true"] { opacity: 0.5; cursor: not-allowed; }
  .btn svg { width: 1em; height: 1em; flex: none; }
  .btn-primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .btn-primary:hover:not(:disabled) { background: var(--accent-hover); border-color: var(--accent-hover); color: var(--accent-ink); }
  .btn-outline { background: transparent; color: var(--text); border-color: var(--border); }
  .btn-outline:hover:not(:disabled) { border-color: var(--text-dim); color: var(--text); background: rgba(255,255,255,0.03); }
  .btn-text { background: none; color: var(--text-dim); padding: 6px 10px; font-size: 0.85rem; font-weight: 500; }
  .btn-text:hover:not(:disabled) { color: var(--text); background: rgba(255,255,255,0.05); }
  .btn-danger { background: transparent; color: var(--danger); border-color: var(--danger); }
  .btn-danger:hover:not(:disabled) { background: var(--danger); color: var(--accent-ink); }
  .btn-text-danger:hover:not(:disabled) { color: var(--danger); background: var(--danger-bg); }
  .btn-sm { font-size: 0.82rem; padding: 6px 12px; }
  .btn-lg { font-size: 1rem; padding: 13px 22px; }
  .btn-block { width: 100%; }
  .btn-icon { padding: 8px; width: 36px; height: 36px; }
  .btn-icon svg { width: 18px; height: 18px; }
  .btn.busy { position: relative; color: transparent !important; }
  .btn.busy::after {
    content: '';
    position: absolute; inset: 0; margin: auto;
    width: 16px; height: 16px;
    border: 2px solid rgba(0,0,0,0.25);
    border-top-color: currentColor;
    border-radius: 50%;
    color: var(--accent-ink);
    animation: spin 0.8s linear infinite;
  }
  .btn-outline.busy::after, .btn-text.busy::after { color: var(--text); border-color: var(--border); border-top-color: var(--text); }

  .link-ext { color: var(--accent); text-decoration: none; font-weight: 600; font-size: 0.82rem; }
  .link-ext:hover { text-decoration: underline; }

  /* ── Alerts / status ────────────────────────────────────────────── */
  .alert {
    padding: 12px 16px;
    border-radius: var(--radius);
    margin-bottom: 18px;
    font-size: 0.9rem;
    border: 1px solid;
  }
  .alert-success { background: var(--ok-bg); border-color: var(--ok); color: var(--ok); }
  .alert-error { background: var(--danger-bg); border-color: var(--danger); color: var(--danger); }
  .alert-info { background: var(--pick-bg); border-color: var(--pick); color: var(--pick); }
  .alert-warn { background: var(--warn-bg); border-color: var(--warn); color: var(--warn); }

  .spinner {
    display: inline-block;
    width: 14px; height: 14px;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    flex: none;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .tag {
    display: inline-block;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 7px;
    font-size: 0.74rem;
    color: var(--text-dim);
    font-family: var(--mono);
    line-height: 1.5;
  }
  .badge {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 2px 9px; border-radius: 999px;
    font-size: 0.74rem; font-weight: 600; letter-spacing: 0.02em;
    background: var(--bg-input); color: var(--text-dim); border: 1px solid var(--border);
  }
  .badge-ok { color: var(--ok); border-color: var(--ok); background: var(--ok-bg); }
  .badge-warn { color: var(--warn); border-color: var(--warn); background: var(--warn-bg); }
  .badge-danger { color: var(--danger); border-color: var(--danger); background: var(--danger-bg); }
  .badge-accent { color: var(--accent); border-color: var(--accent); background: var(--accent-bg); }

  .tooltip-trigger {
    display: inline-flex; align-items: center; justify-content: center;
    width: 15px; height: 15px; border-radius: 50%;
    background: var(--border); color: var(--text-dim);
    font-size: 0.65rem; font-weight: 700; cursor: help;
    margin-left: 4px; vertical-align: middle;
  }
  .tooltip-trigger:hover { background: var(--text-dim); color: var(--bg); }

  /* ── Modal ──────────────────────────────────────────────────────── */
  .modal-backdrop {
    position: fixed; inset: 0; z-index: 9000;
    background: rgba(0, 0, 0, 0.62);
    display: flex; align-items: flex-start; justify-content: center;
    padding: 8vh 16px 16px;
    animation: fadeIn 0.12s ease-out;
  }
  .modal {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    width: 520px; max-width: 100%; max-height: 80vh;
    display: flex; flex-direction: column;
    box-shadow: var(--shadow-lg);
    animation: slideIn 0.15s ease-out;
  }
  .modal-header {
    padding: 16px 20px 12px;
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .modal-header h3 { margin: 0; font-size: 1rem; }
  .modal-close {
    background: none; border: none; color: var(--text-dim);
    font-size: 1.4rem; cursor: pointer; padding: 2px 8px; border-radius: 4px; line-height: 1;
  }
  .modal-close:hover { color: var(--text); background: rgba(255,255,255,0.05); }
  .modal-body { padding: 16px 20px; overflow-y: auto; }
  .modal-footer {
    padding: 12px 20px; border-top: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideIn { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    .modal-backdrop, .modal { animation: none; }
    .spinner, .btn.busy::after { animation-duration: 1.6s; }
  }

  /* ── Scrollbars ─────────────────────────────────────────────────── */
  .scroll-thin::-webkit-scrollbar { width: 6px; height: 6px; }
  .scroll-thin::-webkit-scrollbar-track { background: transparent; }
  .scroll-thin::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
</style>
