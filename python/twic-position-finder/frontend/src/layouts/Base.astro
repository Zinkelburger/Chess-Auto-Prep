---
interface Props {
  title: string;
  wide?: boolean;
}
const { title, wide = false } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>♟</text></svg>" />
  <link rel="preconnect" href="https://challenges.cloudflare.com" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <title>{title} — Chess Auto Prep</title>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <nav class="site-nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">♟ Chess Auto Prep</a>
      <div class="nav-links">
        <a href="/twic-notifications" class:list={[{ active: currentPath === '/twic-notifications' || currentPath === '/twic-notifications/' }]}>TWIC Notifications</a>
        <a href="/tactics" class:list={[{ active: currentPath === '/tactics' || currentPath === '/tactics/' }]}>Tactics Trainer</a>
        <a href="/dashboard" class:list={[{ active: currentPath.startsWith('/dashboard') }]}>Dashboard</a>
      </div>
    </div>
  </nav>
  <main id="content" class:list={[{ wide }]}>
    <slot />
  </main>
</body>
</html>

<style is:global>
  :root {
    --bg: #0c0e14;
    --bg-card: #151821;
    --bg-input: #0e1018;
    --border: #2a2f42;
    --text: #eceef4;
    --text-dim: #8f96ab;
    --accent: #5c8a28;
    --accent-hover: #6fa332;
    --danger: #d45b5b;
    --mono: 'JetBrains Mono', monospace;
    --sans: 'Outfit', system-ui, sans-serif;
    --radius: 10px;
    --shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { font-size: 16px; color-scheme: dark; }

  body {
    font-family: var(--sans);
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    line-height: 1.6;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .skip-link {
    position: absolute;
    left: 12px;
    top: -40px;
    z-index: 100;
    background: var(--accent);
    color: #fff;
    padding: 8px 12px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
  }
  .skip-link:focus { top: 12px; }

  /* ── Navigation ──────────────────────────────────── */

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-card) 92%, transparent);
    backdrop-filter: blur(10px);
  }

  .nav-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .nav-logo {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 4px;
  }

  .nav-links a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-dim);
    text-decoration: none;
    padding: 6px 14px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }

  .nav-links a:hover {
    color: var(--text);
    background: rgba(255,255,255,0.04);
  }

  .nav-links a.active {
    color: var(--accent);
    background: rgba(92, 138, 40, 0.12);
  }

  @media (max-width: 520px) {
    .nav-inner { flex-direction: column; height: auto; padding: 12px 16px; gap: 8px; }
    .nav-links { gap: 2px; }
    .nav-links a { font-size: 0.8rem; padding: 5px 10px; }
    .inline-form { flex-direction: column; align-items: stretch; }
    .page-header-actions { width: 100%; }
  }

  /* ── Main ──────────────────────────────────── */

  main {
    flex: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 24px;
    width: 100%;
  }

  main.wide {
    max-width: 1100px;
  }

  /* ── Typography ──────────────────────────────────── */

  h1 { font-size: 2rem; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.02em; }
  h2 { font-size: 1.4rem; font-weight: 600; margin-bottom: 12px; }
  h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 8px; }

  .subtitle { color: var(--text-dim); font-size: 1.05rem; margin-bottom: 32px; }

  /* ── Card ──────────────────────────────────── */

  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    margin-bottom: 16px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .page-header h1 { margin-bottom: 4px; }
  .page-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .lede {
    color: var(--text-dim);
    font-size: 1.02rem;
    max-width: 40em;
    margin: 0;
  }
  .lede a {
    color: var(--accent);
    text-decoration: none;
  }
  .lede a:hover { text-decoration: underline; }

  .auth-panel {
    text-align: center;
    padding: 72px 0;
    max-width: 440px;
    margin: 0 auto;
  }

  .form-actions {
    display: flex;
    gap: 10px;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .field-label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 8px;
    font-weight: 400;
  }
  .optional {
    font-size: 0.75rem;
    color: var(--text-dim);
    font-weight: 400;
    letter-spacing: 0;
  }
  .card-lead {
    color: var(--text-dim);
    font-size: 0.92rem;
    margin: -4px 0 16px;
  }
  .card h2 { font-size: 1.15rem; }
  .inline-form {
    display: flex;
    gap: 12px;
    align-items: flex-end;
  }
  .inline-form .grow { flex: 1; margin-bottom: 0; }
  .inline-form .btn { flex-shrink: 0; }
  form + .alert { margin-top: 14px; }

  .empty-state { text-align: center; padding: 48px 28px; }
  .empty-title { font-size: 1.15rem; font-weight: 600; margin-bottom: 8px; }
  .empty-copy { color: var(--text-dim); font-size: 0.92rem; max-width: 28em; margin: 0 auto; }

  /* ── Forms ──────────────────────────────────── */

  input, select {
    font-family: var(--sans);
    font-size: 0.9rem;
    background: var(--bg-input);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 10px 14px;
    border-radius: 6px;
    width: 100%;
    outline: none;
    transition: border-color 0.15s;
  }
  input:focus, select:focus { border-color: var(--accent); }
  input::placeholder { color: #5a6078; }

  label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 6px;
    font-weight: 400;
  }

  .form-row { margin-bottom: 16px; }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 600px) { .form-grid { grid-template-columns: 1fr; } }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-dim);
    user-select: none;
  }
  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    min-width: 18px;
    accent-color: var(--accent);
    cursor: pointer;
  }

  /* ── Buttons ──────────────────────────────────── */

  button, .btn {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }
  button:disabled, .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .btn-text {
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 6px 10px;
    border-radius: 6px;
  }
  .btn-text:hover { color: var(--text); background: rgba(255,255,255,0.05); }
  .btn-text-danger:hover { color: var(--danger); background: rgba(212, 91, 91, 0.1); }

  .btn-primary {
    background: var(--accent);
    color: #fff;
  }
  .btn-primary:hover { background: var(--accent-hover); }

  .btn-outline {
    background: transparent;
    color: var(--text-dim);
    border: 1px solid var(--border);
  }
  .btn-outline:hover {
    border-color: var(--text-dim);
    color: var(--text);
  }

  .btn-danger {
    background: transparent;
    color: var(--danger);
    border: 1px solid var(--danger);
    font-size: 0.8rem;
    padding: 6px 14px;
  }
  .btn-danger:hover { background: var(--danger); color: #fff; }

  .btn-sm { font-size: 0.8rem; padding: 6px 14px; }

  .btn-secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }
  .btn-secondary:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .btn-secondary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* ── Tooltip trigger ──────────────── */

  .tooltip-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--border);
    color: var(--text-dim);
    font-size: 0.65rem;
    font-weight: 700;
    cursor: help;
    margin-left: 4px;
    vertical-align: middle;
  }
  .tooltip-trigger:hover {
    background: var(--text-dim);
    color: var(--bg);
  }

  /* ── Subscription action buttons ──────────────── */

  .sub-action-btn {
    background: none;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 0.8rem;
    padding: 4px 8px;
    border-radius: 4px;
    font-family: var(--sans);
    transition: color 0.15s, background 0.15s;
  }
  .sub-action-btn:hover {
    color: var(--text);
    background: rgba(255,255,255,0.05);
  }
  .sub-action-delete:hover {
    color: var(--danger);
    background: rgba(224, 82, 82, 0.08);
  }
  .sub-issues {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .sub-no-match {
    font-size: 0.8rem;
    color: var(--text-dim);
    opacity: 0.7;
  }

  /* ── Alerts ──────────────────────────────────── */

  .alert {
    padding: 14px 18px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 0.9rem;
  }
  .alert-success { background: #172613; border: 1px solid #2d5a1a; color: #a0d870; }
  .alert-error { background: #2a1318; border: 1px solid #5a1a2a; color: #f09090; }
  .alert-info { background: #131a2a; border: 1px solid #1a2a5a; color: #7db4d8; }

  /* ── Misc ──────────────────────────────────── */

  code, .mono { font-family: var(--mono); font-size: 0.85em; }

  .tag {
    display: inline-block;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 2px 8px;
    font-size: 0.75rem;
    color: var(--text-dim);
    font-family: var(--mono);
  }

  /* ── Filter rows (dynamic add/remove) ──────────────────────────── */

  .filters-section {
    margin-bottom: 20px;
    padding-top: 4px;
  }
  .filters-header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 12px;
  }
  .filters-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }
  .filters-hint {
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .filter-row {
    display: flex;
    align-items: start;
    gap: 8px;
    margin-bottom: 14px;
    animation: filterIn 0.15s ease-out;
  }
  @keyframes filterIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .filter-row { animation: none; }
    .eco-modal-backdrop, .eco-modal { animation: none; }
  }
  .filter-row .filter-body { flex: 1; }
  .filter-row .filter-body label { margin-bottom: 4px; }
  .filter-input-wrap { position: relative; }
  .filter-remove {
    background: none;
    border: none;
    color: var(--text-dim);
    cursor: pointer;
    font-size: 1.2rem;
    line-height: 1;
    padding: 6px;
    margin-top: 22px;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }
  .filter-remove:hover {
    color: var(--danger);
    background: rgba(212, 91, 91, 0.1);
  }
  .add-filter-wrap { position: relative; }
  .filter-menu {
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 4px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 4px 0;
    min-width: 180px;
    z-index: 100;
    box-shadow: var(--shadow);
  }
  .filter-menu-item {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 8px 14px;
    cursor: pointer;
    font-family: var(--sans);
    border-radius: 0;
  }
  .filter-menu-item:hover { background: rgba(255,255,255,0.05); }
  .filter-menu-item:disabled {
    color: var(--text-dim);
    opacity: 0.4;
    cursor: not-allowed;
  }
  .filter-menu-item:disabled:hover { background: none; }

  /* ── Choice chips ──────────────────────────────────── */

  .choice-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .choice {
    display: inline-flex;
    cursor: pointer;
    user-select: none;
  }
  .choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 1px;
    height: 1px;
  }
  .choice span {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--text-dim);
    background: var(--bg-input);
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .choice:hover span { border-color: var(--text-dim); color: var(--text); }
  .choice input:checked + span {
    background: rgba(92, 138, 40, 0.16);
    border-color: var(--accent);
    color: var(--text);
  }
  .choice input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* ── Autocomplete ──────────────────────────────────── */

  .ac-status {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.95rem;
    line-height: 1;
  }
  .ac-status-ok { color: var(--accent); }
  .ac-status-miss { color: var(--danger); }
  .ac-matches {
    margin-top: 6px;
    font-size: 0.85rem;
    color: var(--text-dim);
    max-height: 140px;
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-input);
    padding: 4px 0;
  }
  .ac-item {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    color: var(--text);
    font-size: 0.85rem;
    font-weight: 400;
    padding: 6px 12px;
    cursor: pointer;
    font-family: var(--sans);
    border-radius: 0;
  }
  .ac-item:hover { background: rgba(255,255,255,0.05); }
  .ac-hint {
    padding: 8px 12px;
    color: var(--text-dim);
    font-size: 0.82rem;
  }
  .ac-more {
    padding: 6px 12px;
    font-style: italic;
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  /* ── Subscription cards ──────────────────────────────────── */

  .sub-card { padding: 0; overflow: hidden; }
  .sub-card-body { padding: 18px 22px 14px; }
  .sub-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .sub-card-title {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.35;
  }
  .sub-card-actions {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }
  .sub-meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 14px;
    margin: 0;
    font-size: 0.82rem;
  }
  .sub-meta dt {
    color: var(--text-dim);
    font-weight: 500;
    padding-top: 1px;
  }
  .sub-meta dd {
    margin: 0;
    color: var(--text);
    word-break: break-word;
  }
  .sub-meta dd.mono {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .sub-card-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-top: 1px solid var(--border);
    background: rgba(0,0,0,0.18);
  }
  .sub-matches {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .issue-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 6px;
  }
  .issue-toggle:hover { border-color: var(--text-dim); }
  .issue-toggle[aria-expanded="true"] {
    border-color: var(--accent);
    background: rgba(92, 138, 40, 0.12);
  }
  .issue-chevron {
    font-size: 0.7rem;
    color: var(--text-dim);
    width: 0.85em;
  }
  .game-panel {
    border-top: 1px solid var(--border);
    background: rgba(0,0,0,0.12);
  }
  .game-panel > .sub-no-match {
    display: block;
    padding: 12px 22px;
  }
  .game-panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 12px 6px 22px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-dim);
  }
  .game-list { padding: 0; }
  .game-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 22px;
    border-top: 1px solid var(--border);
  }
  .game-info { min-width: 0; flex: 1; }
  .game-players { font-size: 0.9rem; }
  .game-sub {
    font-size: 0.78rem;
    color: var(--text-dim);
    margin-top: 2px;
  }
  .game-result {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    margin-left: 8px;
  }
  .result-white { color: var(--accent); }
  .result-black { color: var(--danger); }
  .result-draw { color: var(--text-dim); }
  .lichess-link {
    flex-shrink: 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    padding: 4px 10px;
    border: 1px solid var(--accent);
    border-radius: 4px;
    white-space: nowrap;
  }
  .lichess-link:hover {
    background: var(--accent);
    color: #fff;
  }
  @media (max-width: 600px) {
    .game-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  .cf-turnstile { margin-bottom: 16px; }

  /* ── ECO picker modal ──────────────────────────────────── */

  .eco-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 9000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 8vh;
    animation: fadeIn 0.12s ease-out;
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

  .eco-modal {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    width: 520px;
    max-width: calc(100vw - 32px);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow);
    animation: slideIn 0.15s ease-out;
  }
  @keyframes slideIn { from { opacity: 0; transform: translateY(-12px); } to { opacity: 1; transform: translateY(0); } }

  .eco-modal-header {
    padding: 16px 20px 12px;
    border-bottom: 1px solid var(--border);
