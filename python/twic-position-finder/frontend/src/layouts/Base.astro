<script is:inline>
  function escapeHtml(str) {
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  var PIECE_URLS = {
    K: '/piece/wK.svg', Q: '/piece/wQ.svg', R: '/piece/wR.svg',
    B: '/piece/wB.svg', N: '/piece/wN.svg', P: '/piece/wP.svg',
    k: '/piece/bK.svg', q: '/piece/bQ.svg', r: '/piece/bR.svg',
    b: '/piece/bB.svg', n: '/piece/bN.svg', p: '/piece/bP.svg',
  };

  function renderBoardPreview(fen, boardEl, errorEl) {
    if (!fen || !fen.trim()) {
      boardEl.style.display = 'none';
      if (errorEl) errorEl.style.display = 'none';
      return;
    }
    var placement = fen.trim().split(/\s+/)[0];
    var ranks = placement.split('/');
    if (ranks.length !== 8) {
      boardEl.style.display = 'none';
      if (errorEl) { errorEl.style.display = 'block'; errorEl.textContent = 'Invalid FEN — need 8 ranks separated by /'; }
      return;
    }
    boardEl.innerHTML = '';
    for (var rank = 0; rank < 8; rank++) {
      var file = 0;
      for (var ci = 0; ci < ranks[rank].length; ci++) {
        var ch = ranks[rank][ci];
        if (ch >= '1' && ch <= '8') {
          for (var e = 0; e < parseInt(ch); e++) {
            var sq = document.createElement('div');
            sq.className = 'board-sq ' + ((rank + file) % 2 === 0 ? 'light' : 'dark');
            boardEl.appendChild(sq);
            file++;
          }
        } else if (PIECE_URLS[ch]) {
          var sq = document.createElement('div');
          sq.className = 'board-sq ' + ((rank + file) % 2 === 0 ? 'light' : 'dark');
          var img = document.createElement('img');
          img.src = PIECE_URLS[ch];
          img.alt = ch;
          img.draggable = false;
          sq.appendChild(img);
          boardEl.appendChild(sq);
          file++;
        } else {
          boardEl.style.display = 'none';
          if (errorEl) { errorEl.style.display = 'block'; errorEl.textContent = 'Invalid FEN — unexpected character: ' + ch; }
          return;
        }
      }
      if (file !== 8) {
        boardEl.style.display = 'none';
        if (errorEl) { errorEl.style.display = 'block'; errorEl.textContent = 'Invalid FEN — rank ' + (rank + 1) + ' has ' + file + ' files (need 8)'; }
        return;
      }
    }
    boardEl.style.display = 'grid';
    if (errorEl) errorEl.style.display = 'none';
  }
</script>
