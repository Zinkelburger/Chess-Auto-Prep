---
// The analysis board behind /pgn and /expectimax: one page, opened on the
// tab its address names (src/prep/app.ts). The layout and controls are the
// bughouse board's (analysis.css), without the hands.
import Base from '../layouts/Base.astro';
import '@lichess-org/chessground/assets/chessground.base.css';
import '@lichess-org/chessground/assets/chessground.brown.css';
import '@lichess-org/chessground/assets/chessground.cburnett.css';
import '../styles/bughouse-board.css';
import '../styles/analysis.css';
import '../styles/prep-analysis.css';

interface Props { tab: 'pgn' | 'expectimax' }
const { tab } = Astro.props;

const icon = {
  first: 'M18 17l-5-5 5-5M11 17l-5-5 5-5',
  prev: 'M15 18l-6-6 6-6',
  next: 'M9 18l6-6-6-6',
  last: 'M6 17l5-5-5-5M13 17l5-5-5-5',
  flip: 'M7 4v16M7 4l-3 3M7 4l3 3M17 20V4M17 20l-3-3M17 20l3-3',
  edit: 'M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z',
  threat: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM22 12h-4M6 12H2M12 6V2M12 22v-4',
  menu: 'M4 6h16M4 12h16M4 18h16',
  list: 'M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01',
  gear: 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z',
};
const svg = (d: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
---
<Base
  title={tab === 'pgn' ? 'PGN Viewer' : 'Expectimax'}
  description="Analyse chess in your browser: open PGN games with every variation and comment, Stockfish 18 on the board, and an expectimax search that finds practical moves against human replies with Maia. Nothing to install; your games stay on your device."
>
  <h1 class="visually-hidden">Chess analysis board</h1>
  <div class="ch px" id="ch" data-mode="analysis" data-tab={tab}>
    <section class="ch-stage" aria-label="Board">
      <div class="ch-spare" id="ch-spare-top" role="toolbar" aria-label="Spare pieces" hidden></div>
      <div class="ch-board-wrap" id="ch-board-wrap">
        <div id="ch-board" class="bb-board" role="group" aria-label="Chessboard"></div>
      </div>
      <div class="ch-spare" id="ch-spare-bottom" role="toolbar" aria-label="Spare pieces" hidden></div>
    </section>

    <section class="ch-side" aria-label="Analysis">
      <div class="ch-side-inner">
        <div class="ch-tools" id="ch-tools">
          <div class="ch-analysis" id="ch-analysis">
            <div class="ch-ceval" id="ch-ceval">
              <label class="ch-switch" title="Engine (L)">
                <input type="checkbox" id="ch-engine-on" aria-label="Engine" />
                <span aria-hidden="true"></span>
              </label>
              <span class="ch-pearl num" id="ch-pearl"></span>
              <div class="ch-engine">
                <span class="ch-engine-name" id="ch-engine-name">Stockfish 18</span>
                <span class="ch-engine-info num" id="ch-engine-info"></span>
              </div>
              <button type="button" class="btn btn-outline btn-sm" id="ch-engine-action" hidden></button>
              <p class="visually-hidden" id="ch-eval-live" aria-live="polite"></p>
              <button type="button" class="ch-icon" id="ch-threat" title="Show threat (X)" aria-label="Show threat" aria-pressed="false" set:html={svg(icon.threat)} />
              <button type="button" class="ch-icon" id="ch-gear" title="Engine settings" aria-label="Engine settings" aria-expanded="false" aria-controls="ch-settings" set:html={svg(icon.gear)} />
              <div class="ch-bar" aria-hidden="true"><span id="ch-bar"></span></div>
            </div>
            <div class="ch-settings" id="ch-settings" role="group" aria-label="Engine settings" hidden></div>
            <div class="ch-pvs" id="ch-pvs"></div>
            <div class="ch-pv-board" id="ch-pv-board" role="img" hidden>
              <div class="ch-pv-board-cg bb-board"></div>
            </div>

            <div class="px-tabs" id="px-tabs" role="tablist" aria-label="Panels">
              <button type="button" role="tab" id="px-tab-pgn" aria-controls="px-pgn" aria-selected={tab === 'pgn' ? 'true' : 'false'} title="Moves, comments and games (E switches)">PGN</button>
              <button type="button" role="tab" id="px-tab-expectimax" aria-controls="px-expectimax" aria-selected={tab === 'expectimax' ? 'true' : 'false'} title="Practical moves against human replies (E switches)">Expectimax</button>
            </div>

            <div class="px-panel" id="px-pgn" role="tabpanel" aria-labelledby="px-tab-pgn" hidden={tab !== 'pgn'}>
              <div class="px-game">
                <button type="button" class="ch-icon" id="px-game-list" title="Games" aria-label="Games" aria-expanded="false" aria-controls="px-games" set:html={svg(icon.list)} />
                <div class="px-game-text">
                  <span class="px-game-title" id="px-game-title">Analysis</span>
                  <span class="px-game-details" id="px-game-details"></span>
                </div>
                <button type="button" class="ch-icon" id="px-game-prev" title="Previous game" aria-label="Previous game" hidden set:html={svg(icon.prev)} />
                <span class="px-game-count num" id="px-game-count"></span>
                <button type="button" class="ch-icon" id="px-game-next" title="Next game" aria-label="Next game" hidden set:html={svg(icon.next)} />
              </div>
              <div class="px-games" id="px-games" hidden>
                <input type="search" id="px-games-filter" placeholder="Find a player, event or date" aria-label="Find a game" autocomplete="off" />
                <div class="px-games-list" id="px-games-list"></div>
              </div>
              <div class="ch-moves" id="ch-moves" aria-label="Moves"></div>
              <div class="ch-fork" id="ch-fork" aria-label="Moves played from here" hidden></div>
            </div>

            <div class="px-panel" id="px-expectimax" role="tabpanel" aria-labelledby="px-tab-expectimax" hidden={tab !== 'expectimax'}></div>

            <p class="ch-toast" id="ch-toast" role="status" hidden></p>
          </div>

          <div class="ch-action-menu" id="ch-action-menu" aria-label="Analysis menu" hidden></div>

          <div class="ch-editor" aria-label="Board editor">
            <p class="ch-editor-tip dim">Pick a piece or the bin above or below the board, then click or drag across squares. With the hand, drag pieces around or off the board.</p>
            <div class="ch-choice" id="ch-turn" role="radiogroup" aria-label="Side to move">
              <button type="button" role="radio" data-turn="white" aria-checked="true">White to play</button>
              <button type="button" role="radio" data-turn="black" aria-checked="false">Black to play</button>
            </div>
            <fieldset class="ch-castling" id="ch-castling">
              <legend>Castling</legend>
              <span>White</span>
              <label class="ch-check"><input type="checkbox" data-right="K" /> O-O</label>
              <label class="ch-check"><input type="checkbox" data-right="Q" /> O-O-O</label>
              <span>Black</span>
              <label class="ch-check"><input type="checkbox" data-right="k" /> O-O</label>
              <label class="ch-check"><input type="checkbox" data-right="q" /> O-O-O</label>
            </fieldset>
            <div class="ch-editor-row">
              <button type="button" class="btn btn-outline btn-sm" id="ch-editor-start">Starting position</button>
              <button type="button" class="btn btn-outline btn-sm" id="ch-editor-clear">Clear board</button>
            </div>
            <p class="ch-editor-error" id="ch-editor-error" role="alert"></p>
            <div class="ch-editor-row ch-editor-actions">
              <button type="button" class="btn btn-outline" id="ch-editor-cancel" title="Back to the analysis without changes (Esc)">Cancel</button>
              <button type="button" class="btn btn-primary" id="ch-editor-apply">Analyse this position</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="ch-controls" id="ch-controls" role="toolbar" aria-label="Board controls">
      <button type="button" class="ch-icon" id="ch-flip" title="Flip board (F)" aria-label="Flip board" set:html={svg(icon.flip)} />
      <button type="button" class="ch-icon" id="ch-edit" title="Board editor (B)" aria-label="Board editor" aria-pressed="false" set:html={svg(icon.edit)} />
      <span class="ch-controls-gap"></span>
      <button type="button" class="ch-icon ch-nav" id="ch-first" title="First move (↑)" aria-label="First move" set:html={svg(icon.first)} />
      <button type="button" class="ch-icon ch-nav" id="ch-prev" title="Previous move (←)" aria-label="Previous move" set:html={svg(icon.prev)} />
      <button type="button" class="ch-icon ch-nav" id="ch-next" title="Next move (→)" aria-label="Next move" set:html={svg(icon.next)} />
      <button type="button" class="ch-icon ch-nav" id="ch-last" title="Last move (↓)" aria-label="Last move" set:html={svg(icon.last)} />
      <span class="ch-controls-gap"></span>
      <button type="button" class="ch-icon" id="ch-menu-toggle" title="Menu (H)" aria-label="Menu" aria-expanded="false" aria-controls="ch-action-menu" set:html={svg(icon.menu)} />
    </div>

    <section class="ch-under" aria-label="Position">
      <div class="ch-fen-row">
        <label for="ch-fen">FEN</label>
        <input id="ch-fen" class="mono" spellcheck="false" autocomplete="off" />
        <button type="button" class="btn btn-outline btn-sm" id="ch-fen-copy">Copy</button>
      </div>
      <p class="ch-error" id="ch-fen-error" role="alert"></p>
      <label class="ch-pgn-label" for="ch-pgn">PGN</label>
      <textarea id="ch-pgn" class="mono" rows="4" spellcheck="false"></textarea>
      <div class="ch-pgn-row">
        <p class="ch-error" id="ch-pgn-error" role="alert"></p>
        <label class="btn btn-outline btn-sm" for="ch-pgn-file">Open file<input id="ch-pgn-file" class="visually-hidden" type="file" accept=".pgn,text/plain,application/x-chess-pgn" /></label>
        <button type="button" class="btn btn-outline btn-sm" id="ch-pgn-download">Download</button>
        <button type="button" class="btn btn-outline btn-sm" id="ch-pgn-copy">Copy PGN</button>
        <button type="button" class="btn btn-outline btn-sm" id="ch-pgn-import" disabled>Import PGN</button>
      </div>
      <p class="px-note dim">Games and searches stay in this browser. Stockfish and Maia run on this device. <span id="px-save" class="ch-error" role="status"></span></p>
    </section>
  </div>
</Base>

<script>
  import { PrepApp } from '../prep/app';
  new PrepApp();
</script>
