# Keep private files, desktop assets, databases and local dependencies out of
# the build context. Only the engine's public source and the website enter it.
**
!python/
!python/bughouse-web/
!python/bughouse-web/server.py
!python/bughouse-web/worker.py
!python/bughouse-web/requirements.txt
!python/twic-position-finder/
!python/twic-position-finder/frontend/
!python/twic-position-finder/frontend/package.json
!python/twic-position-finder/frontend/package-lock.json
!python/twic-position-finder/frontend/astro.config.mjs
!python/twic-position-finder/frontend/tsconfig.json
!python/twic-position-finder/frontend/src/
!python/twic-position-finder/frontend/src/**
!python/twic-position-finder/frontend/public/
!python/twic-position-finder/frontend/public/**
!tools/
!tools/fetch_bughouse.py
!tools/bughouse.lock.json
!tools/mcp/
!tools/mcp/bughouse/
!tools/mcp/bughouse/*.py
!assets/
!assets/licenses/
!assets/licenses/HIVEMIND_LICENSE.txt
!assets/licenses/ONNXRUNTIME_LICENSE.txt
!assets/licenses/ONNXRUNTIME_THIRD_PARTY_NOTICES.txt
!LICENSE
