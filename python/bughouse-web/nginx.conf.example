# Add the zone in nginx's http {} block once.
limit_req_zone $binary_remote_addr zone=bughouse_requests:10m rate=3r/s;

# Add this location INSIDE the existing api.chessautoprep.com HTTPS server.
# It preserves the TWIC service on port 8000. nginx must overwrite forwarded
# client headers; configure Uvicorn to trust only this proxy's connection IP.
location /api/bughouse/ {
    client_max_body_size 16k;
    client_body_timeout 10s;
    limit_req zone=bughouse_requests burst=12 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:8080;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 45s;
    proxy_connect_timeout 5s;
}

# For a standalone bughouse.example.com HTTPS vhost, proxy / to port 8080
# instead. The container includes the website at /bughouse/ plus its SVGs.
# Have / redirect to /bughouse/ if you want the tool as the landing page.
