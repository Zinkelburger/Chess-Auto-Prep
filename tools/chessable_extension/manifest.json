{
  "manifest_version": 3,
  "name": "Chessable to PGN",
  "version": "0.1.0",
  "description": "Save a Chessable variation, chapter or whole course you own as a PGN file.",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://www.chessable.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.chessable.com/*"],
      "js": ["chessable_pgn.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chessable-to-pgn@chess-auto-prep.local"
    }
  }
}
