+std::vector<Stockfish::Move> Board::frozen_blocks() const {
+    // Fairy-Stockfish only generates virtual drops that give check, so the
+    // waiting blockers are built here: every empty square between the king
+    // and a single sliding checker. A dropped piece pins nothing and is
+    // pinned by nothing new, so each of these drops answers the check.
+    std::vector<Stockfish::Move> blocks;
+    const Stockfish::Position& position = *pos[0];
+    const Stockfish::Bitboard checkers = position.checkers();
+    if (!checkers || Stockfish::more_than_one(checkers)) {
+        return blocks;
+    }
+    const Stockfish::Color us = position.side_to_move();
+    const Stockfish::Bitboard empty = Stockfish::between_bb(
+        position.square<Stockfish::KING>(us), Stockfish::lsb(checkers))
+        & ~position.pieces() & position.board_bb();
+    for (Stockfish::PieceType blocker : {Stockfish::PAWN, Stockfish::KNIGHT}) {
+        Stockfish::Bitboard squares = empty & position.drop_region(us, blocker);
+        while (squares) {
+            blocks.push_back(Stockfish::make_drop(Stockfish::pop_lsb(squares), blocker, blocker));
+        }
+        if (!blocks.empty()) break;
+    }
+    return blocks;
+}
